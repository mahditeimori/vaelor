# Vaelor MT5 bridge — copy to .env and edit.

BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8899

# Cloud-hosted bridge (Windows VPS): set BRIDGE_HOST=0.0.0.0 to listen on every
# interface and BRIDGE_PUBLIC_HOST=<public-ip-or-domain> for the address the
# browser should use, e.g. http://203.0.113.10:8899.
BRIDGE_PUBLIC_HOST=
# Widen the browser CORS allow-list for a cloud host, e.g.
# BRIDGE_ALLOWED_ORIGIN_REGEX=https?://((\d{1,3}\.){3}\d{1,3}|localhost|127\.0\.0\.1)(:\d+)?

# auto = try MT5, fall back to simulation | simulation | live
BRIDGE_MODE=auto

# Hard interlock for real orders. Keep 0 until you have verified the terminal,
# the account and the symbol suffix. The UI also requires typed confirmation.
ALLOW_LIVE_TRADES=0

# MetaTrader 5 terminal location. The Python package attaches to this install.
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
# Optional: only needed when the terminal is not already logged in.
# MT5_LOGIN=12345678
# MT5_PASSWORD=your-investor-or-master-password
# MT5_SERVER=YourBroker-Demo

# Headless supervision. 0 (desktop default) = never check, reconnect or
# relaunch MetaTrader in the background. Set 1 only on a cloud VPS that must
# keep trading 24/7 after the terminal or PC is closed.
MT5_AUTO_CONNECT=0
# MT5_PORTABLE=0

# Simulation account
SIM_BALANCE=100000
SIM_LEVERAGE=100
# auto = fetch real history from the Vaelor Worker when available, else synthetic
SIM_DATA=auto

# Cloud strategy registry + signal queue (Vaelor Worker)
VAELOR_API=https://trading-llc-mcp.mahdi-t8256.workers.dev
CLOUD_SYNC=1
CLOUD_SYNC_SECONDS=60
