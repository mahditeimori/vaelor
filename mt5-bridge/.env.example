# Vaelor MT5 bridge — copy to .env and edit.
# The bridge always binds to loopback. It never accepts remote connections.

BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8899

# auto = try MT5, fall back to simulation | simulation | live
BRIDGE_MODE=auto

# Hard interlock for real orders. Keep 0 until you have verified the terminal,
# the account and the symbol suffix. The UI also requires typed confirmation.
ALLOW_LIVE_TRADES=0

# MetaTrader 5 terminal location. The Python package attaches to this install.
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
# Optional: only needed when the terminal is not already logged in.
# MT5_LOGIN=12345678
# MT5_PASSWORD=your-investor-or-master-password
# MT5_SERVER=YourBroker-Demo

# Simulation account
SIM_BALANCE=100000
SIM_LEVERAGE=100
# auto = fetch real history from the Vaelor Worker when available, else synthetic
SIM_DATA=auto

# Cloud strategy registry + signal queue (Vaelor Worker)
VAELOR_API=https://trading-llc-mcp.mahdi-t8256.workers.dev
CLOUD_SYNC=1
CLOUD_SYNC_SECONDS=60
