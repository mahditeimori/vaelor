---
interface Props {
  title: string;
  description?: string;
  variant?: 'default' | 'landing';
}
const { title, description = 'Vaelor Trading LLC — Master Operational Manual & Autonomous Execution Specification', variant = 'default' } = Astro.props;
const pageTitle = `${title} — Vaelor Trading LLC`;
import '../styles/global.css';
import '../styles/ui-enhancements.css';
---

<!doctype html>
<html lang="fa">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Playfair+Display:ital,wght@0,600;0,700;1,400&family=Vazirmatn:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/vaelor-icon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{pageTitle}</title>
    <script>
      // Membership bootstrap: defines window.VaelorMembership before any page
      // module runs, then gates docs and locked sections once the DOM is ready.
      import { applyMemberGate } from '../scripts/gate.ts';
      applyMemberGate();
    </script>
  </head>
  <body class={variant}>
    <div class="bg-matrix" aria-hidden="true"></div>
    {variant !== 'landing' && (
      <header class="site-header">
        <a href="/" class="brand" aria-label="Vaelor Trading Intelligence — home">
          <img
            src="/vaelor-trading-intelligence.png"
            alt="Vaelor Trading Intelligence"
            width="760"
            height="253"
            decoding="async"
          />
        </a>
        <nav class="nav-links" aria-label="Primary">
          <a href="/" class="nav-link" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>مشخصات</a>
          <a href="/dashboard" class="nav-link" aria-current={Astro.url.pathname.startsWith('/dashboard') ? 'page' : undefined}>داشبورد مشتری</a>
          <a href="/terminal" class="nav-link" aria-current={Astro.url.pathname.startsWith('/terminal') ? 'page' : undefined}>ترمینال</a>
          <a href="/execution" class="nav-link" aria-current={Astro.url.pathname.startsWith('/execution') ? 'page' : undefined}>اجرا</a>
          <a href="/ai" class="nav-link" aria-current={Astro.url.pathname.startsWith('/ai') ? 'page' : undefined}>هوش مصنوعی</a>
          <a href="/login.html" class="nav-link" aria-current={Astro.url.pathname.startsWith('/login') ? 'page' : undefined}>ورود / Sign in</a>
        </nav>
      </header>
    )}
    <slot />
    <footer class="site-footer">
      <div class="shell">
        <div class="mono" style="font-family:var(--mono);font-size:0.72rem;letter-spacing:0.24em;text-transform:uppercase;color:var(--text-faint)">
          Vaelor Trading Intelligence · Master Operational Manual
        </div>
        <div class="mono" style="margin-top:8px;font-size:0.68rem;letter-spacing:0.14em;text-transform:uppercase;color:var(--text-faint)">
          Version 2.0.1 · Standard Identifier <span style="color:var(--accent-warm)">TLLC-OPS-V2.0.1-FINAL</span> · Classification: Operational Protocol
        </div>
        <div style="margin-top:22px;padding-top:18px;border-top:1px solid rgba(201, 162, 75, 0.14)">
          <div class="mono" style="font-size:0.68rem;letter-spacing:0.16em;text-transform:uppercase;color:var(--text-faint)">
            Private operator surface · Members see tools, never source
          </div>
          <div class="mono" style="margin-top:10px;font-size:0.68rem;letter-spacing:0.14em;text-transform:uppercase;color:var(--text-faint)">
            <a href="/privacy" style="color:inherit">Privacy</a>
            <span style="color:var(--accent-warm)"> · </span>
            <a href="/terms" style="color:inherit">Terms</a>
          </div>
        </div>
      </div>
    </footer>
    <script>
      import { mountMatrixBg } from '../scripts/matrix-bg.ts';
      mountMatrixBg();
    </script>
  </body>
</html>
