---
interface Props {
  title: string;
  description?: string;
  variant?: 'default' | 'landing';
}
const { title, description = 'Vaelor Trading LLC — Master Operational Manual & Autonomous Execution Specification', variant = 'default' } = Astro.props;
const pageTitle = `${title} — Vaelor Trading LLC`;
import '../styles/global.css';
import '../styles/ui-enhancements.css';
import '../styles/scroll-animations.css';
---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Playfair+Display:ital,wght@0,600;0,700;1,400&family=Vazirmatn:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/vaelor-icon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{pageTitle}</title>
    <script>
      // Membership bootstrap: defines window.VaelorMembership before any page
      // module runs, then gates docs and locked sections once the DOM is ready.
      import { applyMemberGate } from '../scripts/gate.ts';
      import { mountUI } from '../scripts/ui.ts';
      applyMemberGate();
      mountUI();
    </script>
  </head>
  <body class={variant}>
    <div class="scroll-progress" id="scrollProgress" aria-hidden="true"></div>
    <div class="site-mark" id="siteMark" aria-hidden="true">
      <svg class="site-mark-svg" viewBox="0 0 120 60" width="120" height="60">
        <path class="site-mark-path" d="M30 58 L60 8 L90 58" fill="none" stroke="var(--gold)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
    <div class="bg-matrix" aria-hidden="true"></div>
    {variant !== 'landing' && (
      <header class="site-header">
        <div class="nav-split">
          <div class="nav-features">
            <a href="/" class="brand" aria-label="Vaelor home">
              <img src="/vaelor-trading-intelligence.png" alt="Vaelor" width="760" height="253" decoding="async" />
            </a>
            <a href="/" class="nav-link" data-i18n="nav.home" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>نمای کلی</a>
            <a href="/dashboard" class="nav-link" data-i18n="nav.dashboard" aria-current={Astro.url.pathname.startsWith('/dashboard') ? 'page' : undefined}>تحلیل ماکرو</a>
            <a href="/terminal" class="nav-link" data-i18n="nav.terminal" aria-current={Astro.url.pathname.startsWith('/terminal') ? 'page' : undefined}>ترمینال</a>
            <a href="/execution" class="nav-link" data-i18n="nav.execution" aria-current={Astro.url.pathname.startsWith('/execution') ? 'page' : undefined}>اجرا</a>
            <a href="/ai" class="nav-link" data-i18n="nav.ai" aria-current={Astro.url.pathname.startsWith('/ai') ? 'page' : undefined}>هوش مصنوعی</a>
          </div>
          <div class="nav-actions">
            <div class="lang-toggle" aria-label="Language">
              <button type="button" data-lang="fa" class="is-active">FA</button>
              <button type="button" data-lang="en">EN</button>
            </div>
            <a href="/login.html" class="nav-signin" data-i18n="nav.signin">ورود / ثبت نام</a>
            <a href="/member/dashboard" class="nav-cta" data-i18n="nav.openAccount">داشبورد مشتری</a>
          </div>
        </div>
      </header>
    )}
    <slot />
    <footer class="site-footer">
      <div class="shell" style="display:flex;flex-wrap:wrap;gap:14px;align-items:center;justify-content:space-between;padding-top:18px;border-top:1px solid var(--border)">
        <div class="mono" style="font-family:var(--mono);font-size:0.7rem;letter-spacing:0.12em;color:var(--text-faint)" data-i18n="footer.brand">
          Vaelor Trading Intelligence
        </div>
        <div class="mono" style="display:flex;gap:16px;font-size:0.7rem;letter-spacing:0.08em;color:var(--text-faint)">
          <a href="/privacy" data-i18n="footer.privacy">حریم خصوصی</a>
          <a href="/terms" data-i18n="footer.terms">شرایط</a>
          <a href="/docs">docs</a>
        </div>
      </div>
    </footer>
    <script>
      import { mountMatrixBg } from '../scripts/matrix-bg.ts';
      mountMatrixBg();
    </script>
  </body>
</html>
