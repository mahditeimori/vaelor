---
/**
 * InstitutionalChartHub.astro
 * Fixed: All Upper & Lower TradingView widgets use 100% embed-authorized live feeds (zero CME popup blocks)
 * + Direct CME Futures Contract OHLCV Stream (NQ=F, ES=F, YM=F, GC=F, SI=F, DX=F)
 */
---

<section id="institutional-chart-section" class="ich-root" aria-label="Institutional Chart & Macro Intelligence Hub">
  <div class="ich-telemetry-bar">
    <div class="ich-telemetry-left">
      <span class="ich-pulse-dot"></span>
      <span class="ich-telemetry-badge">ZERO-TOUCH AUTONOMOUS ENGINE</span>
      <span class="ich-telemetry-item">Price Stream: <strong>TradingView WebSocket + CME Futures Feed (Live)</strong></span>
      <span class="ich-telemetry-sep">•</span>
      <span class="ich-telemetry-item">Macro / COT Feed: <strong>US Gov CFTC + CME + Finviz Auto-Sync</strong></span>
    </div>
    <div class="ich-telemetry-right">
      <span class="ich-telemetry-item">Auto-Poll Cycle: <strong id="ich-poll-countdown">60s</strong></span>
      <span class="ich-telemetry-sep">•</span>
      <span class="ich-telemetry-item">Last Telemetry Sync: <strong id="ich-last-sync-stamp">Live</strong></span>
    </div>
  </div>

  <!-- UPPER WORKSPACE: LIVE REAL-TIME PRICE CHARTS -->
  <div class="ich-panel ich-upper-workspace">
    <div class="ich-panel-header">
      <div>
        <div class="ich-kicker">UPPER WORKSPACE · REAL-TIME STREAMING EXECUTION TERMINAL</div>
        <h2 class="ich-title">Live Price Action, Spot Metals & Index Futures</h2>
        <p class="ich-subtitle">
          24/5 live streaming terminal (`America/New_York` EST) with full institutional drawing suite (Fair Value Gaps, Order Blocks, Fibonacci, Volume Profile) and embed-authorized index/futures feeds.
        </p>
      </div>

      <div class="ich-control-group" role="group" aria-label="Live Chart Style Switcher">
        <span class="ich-control-label">Chart Style</span>
        <div class="ich-btn-group" id="ich-tv-style-group">
          <button type="button" class="ich-toggle-btn active" data-tv-style="1">Candlestick</button>
          <button type="button" class="ich-toggle-btn" data-tv-style="0">Bar (OHLC)</button>
          <button type="button" class="ich-toggle-btn" data-tv-style="2">Line</button>
        </div>
      </div>
    </div>

    <!-- Custom Instrument Switcher Tabs (Embed-Authorized Tickers — Zero CME Restrictions) -->
    <div class="ich-instrument-tabs" id="ich-tv-instrument-tabs" role="tablist">
      <button type="button" class="ich-inst-tab active" data-tv-symbol="OANDA:XAUUSD" data-macro-link="gold">
        <span class="ich-inst-code">XAU/USD · GC</span>
        <span class="ich-inst-name">Gold Spot / Futures Proxy</span>
      </button>
      <button type="button" class="ich-inst-tab" data-tv-symbol="OANDA:XAGUSD" data-macro-link="silver">
        <span class="ich-inst-code">XAG/USD · SI</span>
        <span class="ich-inst-name">Silver Spot / Futures Proxy</span>
      </button>
      <button type="button" class="ich-inst-tab" data-tv-symbol="CAPITALCOM:DXY" data-macro-link="dxy">
        <span class="ich-inst-code">DXY · DX1!</span>
        <span class="ich-inst-name">US Dollar Index (Live)</span>
      </button>
      <button type="button" class="ich-inst-tab" data-tv-symbol="BLACKBULL:USTEC" data-macro-link="nasdaq">
        <span class="ich-inst-code">USTEC.f</span>
        <span class="ich-inst-name">Nasdaq Cash (BlackBull)</span>
      </button>
      <button type="button" class="ich-inst-tab" data-tv-symbol="CAPITALCOM:US100" data-macro-link="nasdaq">
        <span class="ich-inst-code">NQ1! · US100</span>
        <span class="ich-inst-name">Nasdaq 100 Futures Feed</span>
      </button>
      <button type="button" class="ich-inst-tab" data-tv-symbol="FOREXCOM:SPXUSD" data-macro-link="sp500">
        <span class="ich-inst-code">ES1! · SPX500</span>
        <span class="ich-inst-name">S&P 500 Futures Feed</span>
      </button>
      <button type="button" class="ich-inst-tab" data-tv-symbol="FOREXCOM:DJI" data-macro-link="dow">
        <span class="ich-inst-code">YM1! · US30</span>
        <span class="ich-inst-name">Dow Jones Futures Feed</span>
      </button>
    </div>

    <div class="ich-tv-stage-wrap">
      <div id="ich-tv-live-chart" class="ich-tv-stage"></div>
    </div>
  </div>

  <!-- LOWER WORKSPACE: INSTITUTIONAL MACRO, CFTC COT, CME FUTURES STREAM & FINVIZ TERMINAL -->
  <div class="ich-panel ich-lower-workspace">
    <div class="ich-panel-header">
      <div>
        <div class="ich-kicker">LOWER WORKSPACE · US GOV CFTC COT, CME FUTURES TAPE & FINVIZ MACRO ENGINE</div>
        <h2 class="ich-title">Institutional Macro & Positioning Terminal</h2>
        <p class="ich-subtitle">
          Autonomous weekly CFTC Commitment of Traders (Commercial Hedgers, Banks / Swap Dealers, Large Speculators), Net Position Deltas (Δ Net), and live CME Futures (`NQ=F`, `ES=F`, `YM=F`, `GC=F`, `SI=F`) volume & open interest.
        </p>
      </div>

      <div class="ich-view-tabs" id="ich-macro-view-tabs" role="tablist">
        <button type="button" class="ich-view-tab active" data-macro-view="view-cftc-canvas">
          1. CFTC COT & Net Positioning (Interactive Canvas)
        </button>
        <button type="button" class="ich-view-tab" data-macro-view="view-tv-cot-iframe">
          2. Live Futures & COT Structure Terminal
        </button>
        <button type="button" class="ich-view-tab" data-macro-view="view-finviz-cot">
          3. Finviz Macro COT Overview
        </button>
      </div>
    </div>

    <div class="ich-macro-toolbar">
      <div class="ich-asset-selector" id="ich-macro-asset-tabs" role="group" aria-label="Unified Macro Asset Selector">
        <button type="button" class="ich-asset-btn active" data-asset-key="gold">Gold (GC · #088691)</button>
        <button type="button" class="ich-asset-btn" data-asset-key="silver">Silver (SI · #084691)</button>
        <button type="button" class="ich-asset-btn" data-asset-key="dxy">DXY (USD Index · #098662)</button>
        <button type="button" class="ich-asset-btn" data-asset-key="nasdaq">Nasdaq 100 (NQ · #209742)</button>
        <button type="button" class="ich-asset-btn" data-asset-key="sp500">S&P 500 (ES · #13874A)</button>
        <button type="button" class="ich-asset-btn" data-asset-key="dow">Dow Jones (YM · #124603)</button>
      </div>
      <div class="ich-cftc-meta">
        <span>CFTC Contract: <strong id="ich-meta-contract">GOLD - COMMODITY EXCHANGE INC. (#088691)</strong></span>
        <span class="ich-telemetry-sep">•</span>
        <span>Report Date: <strong id="ich-meta-date">2026-11-03</strong></span>
      </div>
    </div>

    <div class="ich-kpi-grid">
      <div class="ich-kpi-card">
        <span class="ich-kpi-label">Commercial / Bank Net Position</span>
        <span class="ich-kpi-value mono" id="ich-kpi-comm-net">-204,902</span>
        <span class="ich-kpi-sub" id="ich-kpi-comm-detail">Long: 64,326 · Short: 269,228</span>
      </div>
      <div class="ich-kpi-card">
        <span class="ich-kpi-label">Weekly Δ Net (Commercials)</span>
        <span class="ich-kpi-value mono ich-pos" id="ich-kpi-comm-delta">+10,722</span>
        <span class="ich-kpi-sub" id="ich-kpi-spec-net">Large Spec Net: +179,548 (-6,903)</span>
      </div>
      <div class="ich-kpi-card">
        <span class="ich-kpi-label">Bank / Commercial Long-Short Split</span>
        <span class="ich-kpi-value mono" id="ich-kpi-bank-split">19.3% L / 80.7% S</span>
        <div class="ich-split-bar">
          <div class="ich-split-fill" id="ich-kpi-split-bar" style="width: 19.3%;"></div>
        </div>
      </div>
      <div class="ich-kpi-card">
        <span class="ich-kpi-label">Total Open Interest (CFTC / CME)</span>
        <span class="ich-kpi-value mono" id="ich-kpi-total-oi">399,169</span>
        <span class="ich-kpi-sub" id="ich-kpi-oi-delta">Weekly Δ OI: +2,359 contracts</span>
      </div>
      <div class="ich-kpi-card">
        <span class="ich-kpi-label">Futures Daily Settled Volume</span>
        <span class="ich-kpi-value mono" id="ich-kpi-daily-vol">184,620</span>
        <span class="ich-kpi-sub" id="ich-kpi-vol-source">Source: CME / Yahoo Finance EOD</span>
      </div>
    </div>

    <!-- VIEW 1: US Gov CFTC COT & Net Positioning Interactive Chart -->
    <div id="view-cftc-canvas" class="ich-macro-view active">
      <div class="ich-canvas-controls">
        <div class="ich-control-group">
          <span class="ich-control-label">COT Chart Mode</span>
          <div class="ich-btn-group" id="ich-lw-mode-group">
            <button type="button" class="ich-toggle-btn active" data-lw-mode="histogram">Bar (Histogram)</button>
            <button type="button" class="ich-toggle-btn" data-lw-mode="candlestick">Candlestick (Weekly Range)</button>
            <button type="button" class="ich-toggle-btn" data-lw-mode="line">Line</button>
          </div>
        </div>

        <div class="ich-control-group">
          <span class="ich-control-label">Series Layers</span>
          <div class="ich-series-toggles" id="ich-series-toggles">
            <label class="ich-check-pill active">
              <input type="checkbox" data-series="commNet" checked />
              <span class="ich-dot ich-dot-gold"></span> Commercials / Banks Net
            </label>
            <label class="ich-check-pill active">
              <input type="checkbox" data-series="specNet" checked />
              <span class="ich-dot ich-dot-cherry"></span> Large Speculators Net
            </label>
            <label class="ich-check-pill active">
              <input type="checkbox" data-series="netDelta" checked />
              <span class="ich-dot ich-dot-emerald"></span> Weekly Δ Net Change
            </label>
            <label class="ich-check-pill active">
              <input type="checkbox" data-series="openInterest" checked />
              <span class="ich-dot ich-dot-cyan"></span> Total Open Interest (OI)
            </label>
          </div>
        </div>
      </div>

      <div class="ich-lw-grid">
        <div class="ich-lw-box">
          <div class="ich-lw-head">
            <span>CFTC Institutional Net Positioning (Commercials/Banks vs. Large Speculators & Weekly Δ Net)</span>
            <span class="ich-lw-tag" id="ich-lw-primary-tag">52-Week CFTC Feed</span>
          </div>
          <div id="ich-cot-lw-chart" class="ich-lw-canvas"></div>
        </div>

        <div class="ich-lw-box">
          <div class="ich-lw-head">
            <span>Total Contract Open Interest (OI) & Weekly Participation Expansion</span>
            <span class="ich-lw-tag">CME / ICE Settlement</span>
          </div>
          <div id="ich-oi-lw-chart" class="ich-lw-canvas-sm"></div>
        </div>
      </div>
    </div>

    <!-- VIEW 2: Embed-Authorized TradingView Macro Terminal -->
    <div id="view-tv-cot-iframe" class="ich-macro-view">
      <div class="ich-subview-banner">
        <span>Interactive TradingView Macro Terminal mapped to <strong id="ich-tv-macro-sym-label">OANDA:XAUUSD</strong> (Embed-Authorized Live Feed)</span>
        <a href="https://publicreporting.cftc.gov" target="_blank" rel="noopener noreferrer" class="ich-ext-link">Official CFTC Public Reporting Portal ↗</a>
      </div>
      <div id="ich-tv-macro-chart" class="ich-tv-macro-stage"></div>
    </div>

    <!-- VIEW 3: Finviz Macro COT Overview -->
    <div id="view-finviz-cot" class="ich-macro-view">
      <div class="ich-subview-banner">
        <span id="ich-finviz-caption">Finviz Daily Futures Structure & Sub-Panel CFTC COT Positioning (Commercials, Large Speculators, Small Traders)</span>
        <a id="ich-finviz-direct-link" href="https://finviz.com/futures_charts.ashx?t=GC&p=d" target="_blank" rel="noopener noreferrer" class="ich-ext-link">Open Finviz Full Futures View ↗</a>
      </div>
      <div class="ich-finviz-frame">
        <img id="ich-finviz-img" src="https://charts2-node.finviz.com/chart?w=860&h=460&bw=2&bm=1&bb=1&t=@GC&tf=d&s=linear&pm=0&am=0&ct=candle_stick&tm=d&r=&sf=2" alt="Finviz Futures COT Chart" class="ich-finviz-img" referrerpolicy="no-referrer" />
      </div>
    </div>
  </div>
</section>
