---
import { getCollection } from 'astro:content';

interface Props {
  title: string;
}
const { title } = Astro.props;
const docs = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
const currentPath = Astro.url.pathname;

const links = [
  { href: '/docs', label: 'Index' },
  { href: '/docs/company-code', label: 'Company Code' },
  ...docs.map((d) => ({ href: `/docs/${d.id}`, label: d.data.title })),
];
---

<aside class="sidebar" aria-label="Documentation sections">
  <div class="side-title collapse-label">Reference Index</div>
  <button type="button" class="docs-collapse-toggle" data-collapse-toggle aria-expanded="true" aria-label="Collapse panel" title="Collapse">
    <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
  </button>
  {links.map((l) => (
    <a href={l.href} class="side-link" title={l.label} aria-current={currentPath === l.href ? 'page' : undefined}>
      <i class="fa-solid fa-file-lines" aria-hidden="true"></i><span class="collapse-label">{l.label}</span>
    </a>
  ))}
</aside>
