---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SEARCH_INDEX } from '../scripts/landing.ts';

const landingStats = [
  { num: '6', lbl: 'Departments', sub: 'Full ops stack' },
  { num: '10', lbl: 'Operational roles', sub: 'Governance + execution' },
  { num: '5', lbl: 'Macro regimes', sub: 'Reactive, distortion, goldilocks' },
  { num: '4', lbl: 'Market structure surfaces', sub: 'Dashboard + Terminal + Macro + Analysis' },
  { num: '7', lbl: 'Config hooks', sub: 'Env + OTP + origin' },
];

const launchRichDataset = [
  { name: 'Gold (XAUUSD)', regime: 'risk-off', flag: 'Watch', position: 'short-covering', oiShock: '+2.4%', zScore: '+1.2' },
  { name: 'Silver (XAGUSD)', regime: 'reflation', flag: 'Aligned', position: 'long-buildup', oiShock: '+1.1%', zScore: '+0.8' },
  { name: 'S&P 500 (SPX500)', regime: 'goldilocks', flag: 'Watch', position: 'neutral', oiShock: '-0.4%', zScore: '-0.3' },
  { name: 'Nasdaq 100 (NDXUSD)', regime: 'risk-on', flag: 'None', position: 'flat', oiShock: '-1.2%', zScore: '-1.6' },
];

function richText(raw?: string): string {
  return String(raw ?? '').replace(/[<>&"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] ?? c));
}
---

<BaseLayout title="Vaelor Trading LLC — Operating Manual" variant="landing">
  <main class="hero">
    <div class="hero-main">
      <div class="landing-topbar nav-split">
        <div class="nav-features">
          <a href="/" class="nav-pill brand-word">Vaelor <span>TRADING INTELLIGENCE</span></a>
          <a href="/docs" class="nav-pill" data-i18n="nav.docs">مستندات</a>
          <a href="/dashboard" class="nav-pill" data-i18n="nav.dashboard">داشبورد مشتری</a>
          <a href="/terminal" class="nav-pill" data-i18n="nav.terminal">ترمینال</a>
          <a href="/execution" class="nav-pill" data-i18n="nav.execution">اجرا</a>
          <a href="/news" class="nav-pill" data-i18n="nav.news">اخبار</a>
          <a href="/ai" class="nav-pill" data-i18n="nav.ai">هوش مصنوعی</a>
        </div>
        <div class="nav-actions">
          <div class="lang-toggle" aria-label="Language">
            <button type="button" data-lang="fa" class="is-active">FA</button>
            <button type="button" data-lang="en">EN</button>
          </div>
          <a href="/login.html" class="nav-signin" data-i18n="nav.signin">ورود / ثبت نام</a>
          <a href="/member/dashboard" class="nav-cta" data-i18n="nav.openAccount">داشبورد مشتری</a>
        </div>
      </div>

      <div class="hero-grid">
        <div class="hero-left">
          <div class="hero-tag" data-i18n="hero.tag">محیط عملیاتی · Vaelor Trading</div>
          <h1 class="hero-headline">
            <span data-i18n="hero.title1">نمای فازی تنظیم‌شده برای</span> <em class="hero-accent" data-i18n="hero.title2">موقعیت‌های حیوی</em>
          </h1>
          <p class="hero-sub" data-i18n="hero.sub">
            دایرکتورهای یکپارچه، قوانین کاغذی کمتر و هر متغیر در یک پنل بصری قابل اشاره — نه فقط متن خام.
          </p>
          <div class="hero-search" id="searchDock">
            <i class="fa-solid fa-magnifying-glass search-icon" aria-hidden="true"></i>
            <input id="searchInput" type="search" placeholder="جستجو در سایت…" data-i18n-ph="hero.search" aria-label="Search the site" autocomplete="off" />
            <button type="button" class="search-clear" aria-label="Clear" onclick="closeSearch()">×</button>
            <button type="button" class="searcher" aria-label="Search" onclick="openSearch()"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i></button>
          </div>
          <div class="search-results" id="searchResults" role="listbox" aria-label="Search results"></div>

          <div class="hero-actions">
            <a class="btn btn-primary" href="/docs" data-i18n="hero.docs">کتاب عملیاتی</a>
            <a class="btn btn-ghost" href="/execution" data-i18n="nav.execution">اجرا</a>
            <a class="btn btn-ghost" href="/terminal" data-i18n="hero.terminal">ترمینال موقعیتها</a>
          </div>
        </div>

        <div class="hero-right">
          <div class="float-card">
            <div class="hc-name">TLLC · STATS</div>
            {landingStats.map((s) => (
              <div class="hc-row">
                <span class="hc-row-num">{s.num}</span>
                <span class="hc-row-lbl">{richText(s.lbl)}</span>
                <span class="hc-row-sub">{richText(s.sub)}</span>
              </div>
            ))}
          </div>
          <div class="float-card">
            <div class="hc-name">لحظه‌ای · RICH DATA</div>
            {launchRichDataset.map((d) => (
              <div class="hc-row">
                <span class="hc-row-num">{d.name}</span>
                <span class="hc-row-lbl">{d.regime} · {d.flag}</span>
                <span class="hc-row-sub">{d.position} · ΔOI {d.oiShock} · Z {d.zScore}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </main>

  <section class="dashboard-promo">
    <div class="dashboard-promo-body">
      <div class="dashboard-promo-title" data-i18n="promo.title">داشبورد مشتری — Member Dashboard</div>
      <div class="dashboard-promo-desc" data-i18n="promo.desc">
        خلاصه حساب، پوزیشنها و سیگنالهای زنده — از داخل سایت، بدون صفحه کپیشده.
      </div>
    </div>
    <div class="dashboard-promo-action">
      <a class="btn btn-primary" href="/member/dashboard" data-i18n="promo.cta">داشبورد مشتری</a>
    </div>
  </section>

  <script>
    import { initLanding, SEARCH_INDEX } from '../scripts/landing.ts';
    initLanding();

    const input = document.getElementById('searchInput') as HTMLInputElement | null;
    const results = document.getElementById('searchResults');
    const dock = document.getElementById('searchDock');

    function highlight(label: string, q: string): string {
      if (!q) return label;
      const i = label.toLowerCase().indexOf(q);
      if (i < 0) return label;
      return label.slice(0, i) + '<b>' + label.slice(i, i + q.length) + '</b>' + label.slice(i + q.length);
    }

    function renderResults(qRaw: string): void {
      const q = qRaw.trim().toLowerCase();
      const hits = q
        ? SEARCH_INDEX.filter((s) => `${s.label} ${s.keys}`.toLowerCase().includes(q)).slice(0, 8)
        : SEARCH_INDEX.slice(0, 6);
      if (!results) return;
      results.innerHTML = hits
        .map((h, i) => `<a href="${h.href}" role="option"${i === 0 ? ' aria-selected="true"' : ''}>${highlight(h.label, q)}</a>`)
        .join('');
      if (!hits.length) {
        results.innerHTML = '<div style="padding:12px;color:var(--text-faint);font-family:var(--mono);font-size:0.8rem">No matches — try “dashboard” or “risk”</div>';
      }
    }

    if (input && results) {
      input.addEventListener('input', () => {
        dock?.classList.toggle('has-value', input.value.length > 0);
        renderResults(input.value);
      });
      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (!target.closest('.hero-search') && !target.closest('#searchResults')) results.style.display = 'none';
      });
    }

    function openSearch(): void {
      if (!results) return;
      renderResults(input?.value ?? '');
      results.style.display = 'flex';
    }

    function closeSearch(): void {
      if (!results) return;
      results.style.display = 'none';
      if (input) {
        input.value = '';
        dock?.classList.remove('has-value');
      }
    }

    (window as unknown as { openSearch?: () => void; closeSearch?: () => void }).openSearch = openSearch;
    (window as unknown as { openSearch?: () => void; closeSearch?: () => void }).closeSearch = closeSearch;
  </script>
</BaseLayout>
