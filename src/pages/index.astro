---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SEARCH_INDEX } from '../scripts/landing.ts';

const landingStats = [
  { num: '6', lbl: 'Departments', sub: 'Full ops stack' },
  { num: '10', lbl: 'Operational roles', sub: 'Governance + execution' },
  { num: '5', lbl: 'Macro regimes', sub: 'Reactive, distortion, goldilocks' },
  { num: '4', lbl: 'Market structure surfaces', sub: 'Dashboard + Terminal + Macro + Analysis' },
  { num: '7', lbl: 'Config hooks', sub: 'Env + OTP + origin' },
];

const launchRichDataset = [
  { name: 'Gold (XAUUSD)', regime: 'risk-off', flag: 'Watch', position: 'short-covering', oiShock: '+2.4%', zScore: '+1.2' },
  { name: 'Silver (XAGUSD)', regime: 'reflation', flag: 'Aligned', position: 'long-buildup', oiShock: '+1.1%', zScore: '+0.8' },
  { name: 'S&P 500 (SPX500)', regime: 'goldilocks', flag: 'Watch', position: 'neutral', oiShock: '-0.4%', zScore: '-0.3' },
  { name: 'Nasdaq 100 (NDXUSD)', regime: 'risk-on', flag: 'None', position: 'flat', oiShock: '-1.2%', zScore: '-1.6' },
];

function richText(raw?: string): string {
  return String(raw ?? '').replace(/[<>&"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] ?? c));
}
---

<BaseLayout title="Vaelor Trading LLC — Operating Manual" variant="landing">
  <main class="hero">
    <div class="hero-main">
      <div class="landing-topbar">
        <div class="nav-pills-left">
          <button type="button" class="nav-pill is-active" data-nav-pill="docs" aria-current="page">
            <span>دستورات توسعه</span> <span class="brand-word">OPERATIONS</span>
          </button>
          <button type="button" class="nav-pill" data-nav-pill="member">
            <span>داشبورد</span><span class="brand-word">MEMBER</span>
          </button>
        </div>
        <div class="nav-pills-right">
          <a href="/" class="nav-pill brand-word">Vaelor Trading Intelligence</a>
          <a href="/docs" class="nav-pill" data-nav-pill="docs2" aria-current={Astro.url.pathname === '/docs' ? 'page' : undefined}>کتاب</a>
          <a href="/dashboard" class="nav-pill" data-nav-pill="dashboard" aria-current={Astro.url.pathname.startsWith('/dashboard') ? 'page' : undefined}>ساختار نموداری</a>
          <a href="/terminal" class="nav-pill" aria-current={Astro.url.pathname.startsWith('/terminal') ? 'page' : undefined}>ترمینال موقعیت‌ها</a>
          <a href="/news" class="nav-pill" aria-current={Astro.url.pathname.startsWith('/news') ? 'page' : undefined}>اخبار</a>
          <a href="/execution" class="nav-pill" aria-current={Astro.url.pathname.startsWith('/execution') ? 'page' : undefined}>اجرا</a>
          <a href="/docs/company-code" class="nav-pill" data-nav-pill="code">کد شرکت</a>
          <a href="#ai" class="nav-pill">هوش مصنوعی</a>
          <a href="/login.html" class="nav-pill">ورود / Sign in</a>
        </div>
      </div>

      <div class="hero-grid">
        <div class="hero-left">
          <div class="hero-tag">محیط عملیاتی · Vaelor Trading</div>
          <h1 class="hero-headline">
            نمای فازی تنظیم‌شده برای <em class="hero-accent">موقعیت‌های حیوی</em>
          </h1>
          <p class="hero-sub">
            دایرکتورهای یکپارچه مدیریت می‌شوند، قوانین کاغذی کمترین شکل می‌یابند و هر متغیر در یک پنل بصری قابل اشاره است — نه فقط متن خام.
            از همان دیتاهای زنده کسب‌وکار برای طراحی واقعی این صفحه استفاده شده است.
          </p>
          <div class="hero-search">
            <input id="searchInput" type="search" placeholder="بگردید…" aria-label="Search the manual" autocomplete="off" />
            <button type="button" class="searcher" aria-label="Search" onclick="openSearch()">🔍</button>
          </div>
          <div class="search-results" id="searchResults" role="listbox" aria-label="Search results"></div>

          <div class="hero-actions">
            <a class="btn btn-primary" href="/docs">کتاب اپراتیو</a>
            <a class="btn btn-ghost" href="/execution">اجرا</a>
            <a class="btn btn-ghost" href="/terminal">ترمینال موقعیت‌ها</a>
          </div>
        </div>

        <div class="hero-right">
          <div class="float-card">
            <div class="hc-name">TLLC · STATS</div>
            {landingStats.map((s) => (
              <div class="hc-row">
                <span class="hc-row-num">{s.num}</span>
                <span class="hc-row-lbl">{richText(s.lbl)}</span>
                <span class="hc-row-sub">{richText(s.sub)}</span>
              </div>
            ))}
          </div>
          <div class="float-card">
            <div class="hc-name">لحظه‌ای · RICH DATA</div>
            {launchRichDataset.map((d) => (
              <div class="hc-row">
                <span class="hc-row-num">{d.name}</span>
                <span class="hc-row-lbl">{d.regime} · {d.flag}</span>
                <span class="hc-row-sub">{d.position} · ΔOI {d.oiShock} · Z {d.zScore}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </main>

  <section class="dashboard-promo">
    <div class="dashboard-promo-body">
      <div class="dashboard-promo-title">داشبورد مشتری — Member Dashboard</div>
      <div class="dashboard-promo-desc">
        خلاصه حساب و دسترسی زنده به پوزیشن‌ها و سیگنال‌های جدید — از داخل سایت، بدون صفحه کپی‌شده.
      </div>
    </div>
    <div class="dashboard-promo-action">
      <a class="btn btn-primary" href="/member/dashboard">داشبورد مشتری</a>
    </div>
  </section>

  <script>
    import { initLanding, SEARCH_INDEX } from '../scripts/landing.ts';
    initLanding();

    const input = document.getElementById('searchInput') as HTMLInputElement | null;
    const results = document.getElementById('searchResults');

    function highlight(label: string, q: string): string {
      if (!q) return label;
      const i = label.toLowerCase().indexOf(q);
      if (i < 0) return label;
      return label.slice(0, i) + '<b>' + label.slice(i, i + q.length) + '</b>' + label.slice(i + q.length);
    }

    function renderResults(qRaw: string): void {
      const q = qRaw.trim().toLowerCase();
      const hits = q
        ? SEARCH_INDEX.filter((s) => `${s.label} ${s.keys}`.toLowerCase().includes(q)).slice(0, 8)
        : SEARCH_INDEX.slice(0, 6);
      if (!results) return;
      results.innerHTML = hits
        .map((h, i) => `<a href="${h.href}" role="option"${i === 0 ? ' aria-selected="true"' : ''}>${highlight(h.label, q)}</a>`)
        .join('');
      if (!hits.length) {
        results.innerHTML = '<div style="padding:12px;color:var(--text-faint);font-family:var(--mono);font-size:0.8rem">No matches — try “dashboard” or “risk”</div>';
      }
    }

    if (input && results) {
      input.addEventListener('input', () => renderResults(input.value));
      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (!target.closest('.hero-search') && !target.closest('#searchResults')) results.style.display = 'none';
      });
    }

    function openSearch(): void {
      if (!results) return;
      renderResults(input?.value ?? '');
      results.style.display = 'flex';
    }
  </script>
</BaseLayout>
