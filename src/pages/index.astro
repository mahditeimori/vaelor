  { name: 'Gold (XAUUSD)', regime: 'risk-off', flag: 'Watch', position: 'short-covering', oiShock: '+2.4%', zScore: '+1.2' },
  { name: 'Silver (XAGUSD)', regime: 'reflation', flag: 'Aligned', position: 'long-buildup', oiShock: '+1.1%', zScore: '+0.8' },
  { name: 'S&P 500 (SPX500)', regime: 'goldilocks', flag: 'Watch', position: 'neutral', oiShock: '-0.4%', zScore: '-0.3' },
  { name: 'Nasdaq 100 (NDXUSD)', regime: 'risk-on', flag: 'None', position: 'flat', oiShock: '-1.2%', zScore: '-1.6' },
];

function richText(raw?: string): string {
  return String(raw ?? '').replace(/[<>&"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] ?? c));
}

function ariaCurrent(id: string): string | undefined {
  return Astro.url.pathname === id ? 'page' : undefined;
}

function tone(v: boolean, kind: 'positive' | 'warning'): string {
  return v ? kind : 'neutral';
}

function highlight(text: string, q: string, seed: string): string {
  const raw = String(text ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] ?? c));
  const needle = seed.trim().toLowerCase();
  if (!needle) return raw;
  const re = new RegExp(`(${needle.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
  return raw.replace(re, `<mark style="color:#f9688e;background:rgba(225,29,72,.14);border-radius:3px;padding:0 2px">$1</mark>`);
}
