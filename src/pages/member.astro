        border-radius: 13px;
        border: 1px solid rgba(239, 231, 216, 0.12);
        border-top: 2px solid rgba(239, 231, 216, 0.28);
        background: rgba(255, 255, 255, 0.025);
        display: flex;
        flex-direction: column;
        gap: 5px;
      }
      .m-plan.m-plan-best { border-top-color: #8e2a38; background: rgba(142, 42, 56, 0.07); }
      .m-plan b { font-family: 'Playfair Display', serif; font-size: 25px; color: #f6efdf; }
      .m-plan-cad { font-family: 'JetBrains Mono', monospace; font-size: 8.5px; color: #8d8170; letter-spacing: 0.12em; text-transform: uppercase; }
      .m-plan p { font-size: 11.5px; color: #a89c87; line-height: 1.55; margin: 8px 0 12px; }
      .m-plan-btn {
        margin-top: auto;
