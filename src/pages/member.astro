      .m-grid-2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px; }
      .m-grid-2 .m-panel { margin-bottom: 0; }
      .m-dl { margin: 0; display: flex; flex-direction: column; }
      .m-dl > div { display: flex; justify-content: space-between; align-items: baseline; gap: 14px; border-bottom: 1px solid rgba(239, 231, 216, 0.08); padding-bottom: 10px; }
      .m-dl dt {
