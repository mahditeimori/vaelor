      }
      .m-dl dd { margin: 0; font-size: 12.5px; color: #ece2c8; text-align: right; overflow-wrap: anywhere; font-family: 'Inter', sans-serif; }
      .m-inline { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; justify-content: flex-end; }
      .m-ok { color: #c9a24b !important; font-family: 'JetBrains Mono', monospace; font-size: 9.5px; letter-spacing: 0.1em; text-transform: uppercase; }
      .m-cta {
