      }
      .m-plan-btn:hover { background: rgba(201, 162, 75, 0.12); border-color: rgba(201, 162, 75, 0.55); color: #f6efdf; }
      .m-member-note { font-size: 12.5px; line-height: 1.75; color: #d8cbae; margin: 0 0 14px; font-family: 'Inter', sans-serif; }
      .m-fine { font-size: 10px; line-height: 1.7; color: #8d8170; margin: 12px 0 0; }

      #memberToast {
        position: fixed;
        left: 50%;
        bottom: 24px;
        transform: translate(-50%, 16px);
        padding: 12px 18px;
        border-radius: 12px;
        border: 1px solid rgba(201, 162, 75, 0.45);
        background: rgba(22, 17, 13, 0.98);
