---
import '../styles/global.css';
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Vaelor member dashboard — precision execution desk, risk gates, live terminal and operations playbook." />
    <meta name="color-scheme" content="dark" />
    <title>Vaelor Trading LLC — Operational Protocol & Execution Desk</title>
    <!-- Tailwind CSS (design system v2) -->
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts matching the original aesthetic: Playfair Display, Inter, JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,400;1,600&display=swap" rel="stylesheet" />
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <script is:inline>
      tailwind.config = {
        darkMode: 'class',
        theme: {
          extend: {
            fontFamily: {
              sans: ['Inter', 'sans-serif'],
              serif: ['Playfair Display', 'serif'],
              mono: ['JetBrains Mono', 'monospace'],
            },
            colors: {
              vaelor: {
                bg: '#090507',
                card: '#130b0f',
                cardHover: '#1c1016',
                border: '#331d27',
                borderBright: '#592e42',
                crimson: '#e11d48',
                crimsonGlow: '#f43f5e',
                emerald: '#10b981',
                emeraldGlow: '#34d399',
                amber: '#f59e0b',
              },
            },
          },
        },
      };
    </script>

    <style is:global>
      body {
        background-color: #090507;
        color: #f8fafc;
        overflow-x: hidden;
      }

      ::selection {
        background: #e11d48;
        color: #ffffff;
      }

      /* Design-system v2 custom colors (old-money lux / operator preview) */
      .positions-tbody > tr + tr > td {
        border-top: 1px solid rgba(51, 29, 39, 0.6);
      }

      /* Ambient Crimson/Dark Matrix Rain Background Effect */
      .bg-vaelor-mesh {
        background:
          radial-gradient(circle at 20% 25%, rgba(225, 29, 72, 0.14) 0%, transparent 45%),
          radial-gradient(circle at 80% 65%, rgba(159, 18, 57, 0.12) 0%, transparent 50%),
          radial-gradient(circle at 50% 95%, rgba(180, 83, 9, 0.08) 0%, transparent 45%),
          #090507;
      }

      /* Vertical subtle light streaks */
      .matrix-streaks {
        background-image: repeating-linear-gradient(
          90deg,
          transparent,
          transparent 78px,
          rgba(244, 63, 94, 0.04) 79px,
          rgba(244, 63, 94, 0.04) 80px
        );
      }

      /* High-visibility button styles */
      .btn-primary-crimson {
        background: linear-gradient(135deg, #e11d48 0%, #be123c 100%);
        border: 1px solid #fb7185;
        box-shadow: 0 0 20px rgba(225, 29, 72, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.25);
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .btn-primary-crimson:hover:not(:disabled) {
        background: linear-gradient(135deg, #f43f5e 0%, #e11d48 100%);
        box-shadow: 0 0 28px rgba(244, 63, 94, 0.7), inset 0 1px 0 rgba(255, 255, 255, 0.4);
        transform: translateY(-1px);
      }
      .btn-primary-crimson:active:not(:disabled) {
        transform: translateY(1px);
      }

      .btn-secondary-glass {
        background: rgba(35, 19, 27, 0.85);
        border: 1px solid #64364b;
        color: #f1f5f9;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.12);
        transition: all 0.2s ease;
      }
      .btn-secondary-glass:hover {
        background: rgba(56, 29, 42, 0.95);
        border-color: #fb7185;
        color: #ffffff;
        box-shadow: 0 0 18px rgba(244, 63, 94, 0.3);
        transform: translateY(-1px);
      }

      /* Buy / Sell Order Action Buttons */
      .btn-buy-active {
        background: linear-gradient(180deg, rgba(16, 185, 129, 0.28) 0%, rgba(5, 150, 105, 0.45) 100%);
        border: 2px solid #34d399;
        color: #ecfdf5;
        box-shadow: 0 0 22px rgba(16, 185, 129, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.25);
      }
      .btn-buy-inactive {
        background: rgba(16, 185, 129, 0.07);
        border: 1px solid rgba(52, 211, 153, 0.35);
        color: #6ee7b7;
      }
      .btn-buy-inactive:hover {
        background: rgba(16, 185, 129, 0.16);
        border-color: #34d399;
        color: #ecfdf5;
      }

      .btn-sell-active {
        background: linear-gradient(180deg, rgba(225, 29, 72, 0.32) 0%, rgba(159, 18, 57, 0.5) 100%);
        border: 2px solid #fb7185;
        color: #fff1f2;
        box-shadow: 0 0 22px rgba(244, 63, 94, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.25);
      }
      .btn-sell-inactive {
        background: rgba(225, 29, 72, 0.08);
        border: 1px solid rgba(251, 113, 133, 0.35);
        color: #fda4af;
      }
      .btn-sell-inactive:hover {
        background: rgba(225, 29, 72, 0.18);
        border-color: #fb7185;
        color: #fff1f2;
      }

      /* Accordion smooth transitions */
      .accordion-content {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.32s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.25s ease;
        opacity: 0;
      }
      .accordion-content.open {
        max-height: 900px;
        opacity: 1;
      }

      /* Custom Scrollbar */
      ::-webkit-scrollbar {
        width: 8px;
        height: 8px;
      }
      ::-webkit-scrollbar-track {
        background: #090507;
      }
      ::-webkit-scrollbar-thumb {
        background: #3d202d;
        border-radius: 4px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #e11d48;
      }

      /* Nav pill base (Tailwind utilities can't be extended from config here) */
      .nav-pill-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        padding: 0.25rem 0.85rem;
        border-radius: 9999px;
        font-size: 0.75rem;
        font-weight: 500;
        transition-property: all;
        transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
        transition-duration: 150ms;
      }

      /* Design-system v2 custom colors (old-money lux / operator preview) */
      .vaelor-card {
        background: #130b0f;
        border: 1px solid #331d27;
        border-radius: 14px;
      }
      .vaelor-card\/90 {
        background: rgba(19, 11, 15, 0.9);
      }
      .vaelor-card\/95 {
        background: rgba(19, 11, 15, 0.95);
      }
      .vaelor-border {
        border-color: #331d27;
      }
      .vaelor-border-bright {
        border-color: #592e42;
      }
    </style>
  </head>
  <body class="bg-vaelor-mesh matrix-streaks min-h-screen font-sans selection:bg-rose-600 selection:text-white flex flex-col">
    <!-- TOP NAVIGATION BAR -->
    <header class="sticky top-0 z-40 backdrop-blur-xl bg-[#090507]/85 border-b border-[#331d27] px-4 lg:px-8 py-3">
      <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-3 bg-[#140b10]/95 border border-[#592e42] rounded-full px-3 py-1.5 shadow-lg">
          <button onclick="switchTab('overview')" class="flex items-center gap-2.5 pr-3 border-r border-[#331d27] group text-left">
            <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-rose-600 to-rose-900 border border-rose-400/60 flex items-center justify-center shadow-md group-hover:scale-105 transition">
              <span class="font-serif font-bold text-white text-base tracking-tighter">V</span>
            </div>
            <div>
              <div class="text-xs font-bold tracking-widest text-white flex items-center gap-1">
                VAELOR <span class="text-[9px] text-rose-400 font-mono font-normal">LLC</span>
              </div>
              <div class="text-[9px] font-mono tracking-widest text-slate-400 uppercase">Trading Intelligence</div>
            </div>
          </button>

          <nav class="flex items-center gap-1 overflow-x-auto py-0.5" aria-label="Main Navigation">
            <button onclick="switchTab('overview')" id="nav-overview" class="nav-pill-btn px-3.5 py-1.5 rounded-full text-xs font-medium transition-all flex items-center gap-1.5 text-slate-300 hover:text-white hover:bg-white/5 border border-transparent">
              <i class="fa-solid fa-compass text-[11px]"></i> Overview
            </button>
            <button onclick="switchTab('execution')" id="nav-execution" class="nav-pill-btn px-3.5 py-1.5 rounded-full text-xs font-medium transition-all flex items-center gap-1.5 text-slate-300 hover:text-white hover:bg-white/5 border border-transparent">
              <i class="fa-solid fa-bolt text-[11px]"></i> Execution Desk
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            </button>
            <button onclick="switchTab('terminal')" id="nav-terminal" class="nav-pill-btn px-3.5 py-1.5 rounded-full text-xs font-medium transition-all flex items-center gap-1.5 text-slate-300 hover:text-white hover:bg-white/5 border border-transparent">
              <i class="fa-solid fa-chart-line text-[11px]"></i> Live Terminal
              <span id="nav-pos-count" class="px-1.5 py-0.2 bg-rose-500/20 border border-rose-500/40 text-rose-300 rounded-full text-[10px] font-mono">2</span>
            </button>
            <button onclick="switchTab('playbook')" id="nav-playbook" class="nav-pill-btn px-3.5 py-1.5 rounded-full text-xs font-medium transition-all flex items-center gap-1.5 text-slate-300 hover:text-white hover:bg-white/5 border border-transparent">
              <i class="fa-solid fa-book-open-reader text-[11px] text-amber-400"></i> Playbook
            </button>
          </nav>
        </div>

        <div class="flex items-center gap-3">
          <button onclick="refreshBridgeConnection()" id="bridge-status-pill" title="Re-check your cloud bridge connection" class="hidden sm:flex items-center gap-2 px-3 py-1.5 rounded-full bg-amber-950/60 border border-amber-500/50 text-amber-200 text-xs font-mono hover:bg-amber-900/70 transition cursor-pointer">
            <span id="bridge-dot" class="w-2 h-2 rounded-full bg-amber-400"></span>
            <span id="bridge-text">BRIDGE: NOT PAIRED</span>
          </button>

          <div class="flex items-center gap-2 bg-[#160c11] border border-[#592e42] rounded-full p-1 pl-3.5 shadow-inner">
            <div class="flex items-center gap-2">
              <span id="auth-indicator" class="w-2 h-2 rounded-full bg-rose-400"></span>
              <span id="member-handle" class="text-xs font-mono text-slate-200 tracking-tight">MEMBER · @arthur.vance</span>
            </div>
            <button onclick="openSignInModal()" id="header-signin-btn" class="btn-primary-crimson text-white text-xs font-semibold px-4 py-1.5 rounded-full flex items-center gap-1.5 ml-1">
              <i class="fa-solid fa-link text-[11px]"></i>
              <span id="signin-btn-label">Account / Pairing</span>
            </button>
          </div>
        </div>
      </div>
    </header>

    <main class="flex-1 max-w-7xl w-full mx-auto px-4 lg:px-8 py-8">
      <div id="data-mode-banner" class="mb-6 flex items-start gap-3 px-4 py-3 rounded-xl bg-amber-950/40 border border-amber-500/50 text-amber-200 text-xs sm:text-sm leading-relaxed">
        <i class="fa-solid fa-triangle-exclamation text-amber-400 mt-0.5"></i>
        <div>
          <strong class="text-amber-300 font-mono">PREVIEW DATA — NO BRIDGE PAIRED.</strong>
          Quotes, blotter rows and fills on this page are illustrative samples, not your account.
          Pair your cloud bridge in <em>Account / Auth</em> and this banner disappears.
        </div>
      </div>
      <!-- TAB 1: OVERVIEW -->
      <section id="view-overview" class="tab-view space-y-12 py-6">
        <div class="max-w-4xl mx-auto pt-4 lg:pt-12">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-rose-950/60 border border-rose-500/40 text-rose-300 font-mono text-[11px] uppercase tracking-[0.2em] mb-6">
            <span class="w-1.5 h-1.5 rounded-full bg-rose-400 animate-ping"></span>
            Algorithmic Futures Trading · Operational Protocol
          </div>

          <h1 class="font-serif text-5xl sm:text-7xl lg:text-8xl font-bold tracking-tight text-white leading-[1.03] mb-6">
            Precision<br />
            that <span class="italic font-normal text-rose-500 drop-shadow-[0_0_25px_rgba(244,63,94,0.35)]">thinks.</span>
          </h1>

          <p class="text-slate-300 text-base sm:text-lg max-w-2xl leading-relaxed mb-8 font-normal">
            Master Operational Manual &amp; Autonomous Execution Specification — macro analysis, bounded autonomous execution, real-time risk gates, and futures market structure analytics.
          </p>

          <div class="flex flex-wrap items-center gap-2.5 mb-9 font-mono text-xs">
            <span class="px-3 py-1 rounded-full bg-emerald-950/80 border border-emerald-500/50 text-emerald-300 flex items-center gap-1.5">
              <i class="fa-solid fa-circle-check text-[10px]"></i> Version 2.0.1
            </span>
            <span class="px-3 py-1 rounded-full bg-[#1a0f15] border border-[#592e42] text-slate-200">
              TLLC-OPS-V2.0.1-FINAL
            </span>
            <span class="px-3 py-1 rounded-full bg-amber-950/70 border border-amber-500/50 text-amber-300">
              <i class="fa-solid fa-shield-halved text-[10px] mr-1"></i> Confirmed · Deployment Ready
            </span>
          </div>

          <div class="flex flex-wrap items-center gap-4">
            <button onclick="switchTab('execution')" class="btn-primary-crimson px-7 py-3.5 rounded-full font-semibold text-sm text-white flex items-center gap-2.5">
              <i class="fa-solid fa-terminal"></i>
              <span>Launch Execution Desk</span>
              <i class="fa-solid fa-arrow-right text-xs"></i>
            </button>

            <button onclick="switchTab('terminal')" class="btn-secondary-glass px-7 py-3.5 rounded-full font-semibold text-sm text-white flex items-center gap-2.5">
              <i class="fa-solid fa-chart-candlestick text-rose-400"></i>
              <span>Open Live Terminal</span>
            </button>

            <button onclick="switchTab('playbook')" class="btn-secondary-glass px-6 py-3.5 rounded-full font-medium text-sm flex items-center gap-2 border-amber-500/50 text-amber-200 hover:border-amber-400">
              <i class="fa-solid fa-book-open text-amber-400"></i>
              <span>Open Operations Playbook</span>
            </button>
          </div>
        </div>

        <div class="max-w-4xl mx-auto pt-8 border-t border-[#331d27]/80">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-xs font-mono uppercase tracking-widest text-rose-400">Expandable Operational Specifications (Click to Expand)</h2>
            <span class="text-xs text-slate-400 font-mono">2 Core Modules</span>
          </div>

          <div class="space-y-3">
            <div class="bg-[#130b0f]/90 border border-[#592e42] rounded-xl overflow-hidden">
              <button onclick="toggleAccordion('acc-macro')" class="w-full px-5 py-4 flex items-center justify-between text-left hover:bg-[#1c1016] transition">
                <div class="flex items-center gap-3">
                  <span class="px-2 py-0.5 rounded bg-rose-500/20 border border-rose-500/40 text-rose-300 font-mono text-xs">MOD 01</span>
                  <span class="font-semibold text-white text-sm sm:text-base">Bounded Autonomous Execution &amp; Kill-Switch Architecture</span>
                </div>
                <i id="icon-acc-macro" class="fa-solid fa-chevron-down text-rose-400 transition-transform duration-300"></i>
              </button>
              <div id="acc-macro" class="accordion-content px-5 border-t border-[#331d27]/60 bg-[#0d070a]">
                <div class="py-4 text-sm text-slate-300 space-y-2 leading-relaxed">
                  <p>Every order routed through your cloud MetaTrader 5 bridge passes through deterministic pre-trade checks: Max Risk Per Trade %, Daily Drawdown Lockout, and Symbol Whitelisting.</p>
                  <div class="flex flex-wrap gap-2 pt-2">
                    <button onclick="switchTab('execution')" class="px-3 py-1.5 rounded-lg bg-rose-600/20 border border-rose-500/50 text-rose-300 text-xs font-mono hover:bg-rose-600/30 transition">Configure Risk Gates →</button>
                  </div>
                </div>
              </div>
            </div>

            <div class="bg-[#130b0f]/90 border border-[#592e42] rounded-xl overflow-hidden">
              <button onclick="toggleAccordion('acc-bridge-overview')" class="w-full px-5 py-4 flex items-center justify-between text-left hover:bg-[#1c1016] transition">
                <div class="flex items-center gap-3">
                  <span class="px-2 py-0.5 rounded bg-emerald-500/20 border border-emerald-500/40 text-emerald-300 font-mono text-xs">MOD 02</span>
                  <span class="font-semibold text-white text-sm sm:text-base">One Dedicated Cloud Bridge Per Member</span>
                </div>
                <i id="icon-acc-bridge-overview" class="fa-solid fa-chevron-down text-rose-400 transition-transform duration-300"></i>
              </button>
              <div id="acc-bridge-overview" class="accordion-content px-5 border-t border-[#331d27]/60 bg-[#0d070a]">
                <div class="py-4 text-sm text-slate-300 space-y-2 leading-relaxed">
                  <p>Your subscription provisions a private bridge instance with its own MetaTrader 5 terminal and account session — it runs whether or not your PC is on. This page talks only to that instance, using the pairing token stored in your browser. Vaelor never holds your broker password and never routes an order you did not submit.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- TAB 2: EXECUTION DESK -->
      <section id="view-execution" class="tab-view hidden space-y-6">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-[#130b0f]/90 border border-[#592e42] rounded-2xl p-5 shadow-xl">
          <div>
            <div class="flex items-center gap-2 text-xs font-mono uppercase tracking-widest text-rose-400 mb-1">
              <span>EXECUTION DESK · METATRADER 5 DIRECT ROUTING</span>
            </div>
            <h2 class="font-serif text-2xl sm:text-3xl font-bold text-white tracking-tight mt-0.5">Manual Order Ticket &amp; Safety Gates</h2>
          </div>

          <div class="flex flex-wrap items-center gap-3">
            <button onclick="toggleAllExecutionAccordions()" class="btn-secondary-glass px-4 py-2 rounded-xl text-xs font-mono flex items-center gap-2">
              <i class="fa-solid fa-layer-group text-rose-400"></i>
              <span>Toggle Setup Drawers</span>
            </button>

            <button onclick="toggleKillSwitch()" id="kill-switch-btn" class="px-4 py-2 rounded-xl text-xs font-mono font-bold uppercase tracking-wider border-2 border-emerald-400 bg-emerald-950/80 text-emerald-200 shadow-[0_0_15px_rgba(16,185,129,0.3)] hover:bg-emerald-900 transition flex items-center gap-2">
              <i class="fa-solid fa-shield-check"></i>
              <span id="kill-switch-label">SAFETY GATES: ARMED</span>
            </button>
          </div>
        </div>

        <div class="bg-[#130b0f]/95 border border-[#592e42] rounded-2xl overflow-hidden shadow-lg">
          <button onclick="toggleAccordion('acc-bridge-setup')" class="w-full px-6 py-4 flex flex-wrap items-center justify-between gap-4 text-left hover:bg-[#1c1016] transition">
            <div class="flex items-center gap-3">
              <div class="w-9 h-9 rounded-xl bg-rose-500/15 border border-rose-500/40 flex items-center justify-center text-rose-400">
                <i class="fa-solid fa-network-wired"></i>
              </div>
              <div>
                <div class="flex items-center gap-2">
                  <span class="text-xs font-mono uppercase tracking-wider text-rose-400">SECTION 01 &amp; 02 · EXPANDABLE DRAWER</span>
                  <span id="bridge-chip" class="px-2 py-0.5 text-[10px] font-mono rounded bg-amber-950 text-amber-300 border border-amber-500/40">BRIDGE NOT PAIRED</span>
                </div>
                <h3 class="text-base font-semibold text-white">Cloud Bridge Pairing &amp; Routing Rules (Click to Expand/Hide)</h3>
              </div>
            </div>
            <div class="flex items-center gap-2 text-xs font-mono text-rose-300 bg-rose-950/60 border border-rose-500/40 px-3 py-1.5 rounded-lg">
              <span id="label-acc-bridge-setup">Show Setup &amp; Notes</span>
              <i id="icon-acc-bridge-setup" class="fa-solid fa-chevron-down transition-transform duration-300"></i>
            </div>
          </button>

          <div id="acc-bridge-setup" class="accordion-content px-6 border-t border-[#331d27] bg-[#0c0609]">
            <div class="p-6 space-y-4">
              <div class="bg-[#070305] border border-[#592e42] rounded-xl p-4">
                <div class="flex items-center justify-between gap-3 mb-2">
                  <span class="text-xs font-mono text-slate-400"># Your dedicated bridge endpoint (from your pairing email):</span>
                  <button onclick="copyCommand('bridge-endpoint')" class="btn-secondary-glass px-3 py-1 rounded-lg text-xs font-mono flex items-center gap-1.5">
                    <i class="fa-regular fa-copy text-rose-400"></i>
                    <span id="copy-btn-text">Copy Endpoint</span>
                  </button>
                </div>
                <pre id="bridge-endpoint" class="font-mono text-xs sm:text-sm text-emerald-300 overflow-x-auto py-1">not paired — open Account / Auth and paste your bridge token</pre>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="p-4 rounded-xl bg-amber-950/25 border-l-4 border-amber-500 border border-amber-500/30 text-xs sm:text-sm text-slate-200 leading-relaxed">
                  <strong class="text-amber-300 block mb-1"><i class="fa-solid fa-server mr-1"></i> The bridge runs in the cloud, not on your PC.</strong>
                  Each member gets a dedicated instance with its own MetaTrader 5 terminal and account session. You never install anything, and closing your laptop does not stop your blotter from updating.
                </div>
                <div class="p-4 rounded-xl bg-amber-950/25 border-l-4 border-amber-500 border border-amber-500/30 text-xs sm:text-sm text-slate-200 leading-relaxed">
                  <strong class="text-amber-300 block mb-1"><i class="fa-solid fa-key mr-1"></i> The pairing token is the only key.</strong>
                  Your token is stored in this browser and sent only to your own instance. Revoke and reissue it from your account page at any time; the old token stops working immediately.
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
          <!-- LEFT: SECTION 03 · MANUAL ROUTING -->
          <div class="lg:col-span-6 bg-[#130b0f]/95 border border-[#592e42] rounded-2xl p-6 shadow-2xl flex flex-col justify-between space-y-5">
            <div>
              <div class="flex items-center justify-between mb-4">
                <div>
                  <div class="text-[11px] font-mono uppercase tracking-widest text-amber-400">SECTION 03 · MANUAL ROUTING</div>
                  <h3 class="text-xl font-bold text-white tracking-tight mt-0.5">ORDER TICKET</h3>
                </div>
