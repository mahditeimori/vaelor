---
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Vaelor member dashboard — plan, capabilities, AI copilot and notifications." />
    <meta name="color-scheme" content="dark" />
    <title>Member dashboard — Vaelor Trading LLC</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Playfair+Display:ital,wght@0,600;0,700;1,400&display=swap" rel="stylesheet" />
  </head>
  <body class="member-body">
    <div id="memberPage" class="m-shell">
      <!-- ===================== SIDEBAR ===================== -->
      <aside class="m-side" aria-label="Member navigation">
        <a class="m-brand" href="/" aria-label="Vaelor Trading Intelligence — home">
          <img src="/vaelor-trading-intelligence.png" alt="Vaelor Trading Intelligence" width="760" height="253" />
        </a>

        <div class="m-profile">
          <div class="m-avatar" id="mAvatar">—</div>
          <div class="m-profile-txt">
            <b id="mName">Member</b>
            <span id="mHandle">@member</span>
          </div>
          <span class="m-tier" id="mTierBadge" data-tier="free">FREE</span>
        </div>

        <nav class="m-nav" aria-label="Dashboard sections">
          <button type="button" class="m-nav-btn active" data-view-link="overview" aria-current="page">
            <span class="m-nav-ic" aria-hidden="true">◧</span> Overview
          </button>
          <button type="button" class="m-nav-btn" data-view-link="capabilities">
            <span class="m-nav-ic" aria-hidden="true">◇</span> Capabilities
          </button>
          <button type="button" class="m-nav-btn" data-view-link="copilot">
            <span class="m-nav-ic" aria-hidden="true">✦</span> AI Copilot
          </button>
          <button type="button" class="m-nav-btn" data-view-link="notifications">
            <span class="m-nav-ic" aria-hidden="true">◎</span> Notifications
            <span class="m-nav-badge" data-notif-count hidden></span>
          </button>
          <button type="button" class="m-nav-btn" data-view-link="account">
            <span class="m-nav-ic" aria-hidden="true">≡</span> Account &amp; plan
          </button>
        </nav>

        <div class="m-side-plan">
          <div class="m-side-plan-head">
            <span>PLAN</span>
            <b id="mPlanName">Free tier</b>
          </div>
          <div class="m-side-plan-time" id="mPlanTime">No expiry</div>
          <div class="m-meter" aria-hidden="true"><i id="mPlanBar"></i></div>
        </div>

        <div class="m-side-foot">
          <a href="/">← Back to site</a>
          <button type="button" id="mSignOut">Sign out</button>
        </div>
      </aside>

      <!-- ===================== MAIN ===================== -->
      <main class="m-main">
        <header class="m-top">
          <div>
            <div class="m-kicker">MEMBER TERMINAL · PRIVATE</div>
            <h1 id="mViewTitle">Overview</h1>
            <p class="m-greeting" id="mGreeting">Welcome back.</p>
          </div>
          <div class="m-top-right">
            <button type="button" class="m-bell" data-view-link="notifications" aria-label="Notifications">
              ◎<span class="m-bell-dot" data-notif-count hidden></span>
            </button>
            <span class="m-chip" id="mTierStat">Free</span>
          </div>
        </header>

        <!-- ============ OVERVIEW ============ -->
        <section data-view-panel="overview" aria-label="Overview">
          <div class="m-stats">
            <div class="m-stat">
              <span>Membership</span>
              <b id="mTierStat2">—</b>
            </div>
            <div class="m-stat">
              <span>Time remaining</span>
              <b id="mTimeStat">—</b>
            </div>
            <div class="m-stat">
              <span>Features unlocked</span>
              <b><span id="mUnlockedCount">0</span> / <span id="mCapTotal">13</span></b>
            </div>
            <div class="m-stat">
              <span>Locked by plan</span>
              <b id="mLockedCount">0</b>
            </div>
          </div>

          <div class="m-panel">
            <div class="m-panel-head">
              <h2>Quick actions</h2>
              <span class="m-mono">MCP · LIVE DATA</span>
            </div>
            <div class="m-quick">
              <button type="button" data-prompt="What is in the signal queue right now?">Signal queue</button>
              <button type="button" data-prompt="Show this week's high impact macro releases.">This week's news</button>
              <button type="button" data-prompt="How is measured performance across strategies?">Measured performance</button>
              <button type="button" data-view-link="capabilities">Open capabilities</button>
            </div>
          </div>

          <div class="m-panel">
            <div class="m-panel-head">
              <h2>Recent notifications</h2>
              <button type="button" class="m-link" data-view-link="notifications">View all →</button>
            </div>
            <div id="mNotifPreview" class="m-notif-preview">
              <p class="m-empty">Notifications appear as signals, AI results and plan updates arrive.</p>
            </div>
          </div>
        </section>

        <!-- ============ CAPABILITIES ============ -->
        <section data-view-panel="capabilities" aria-label="Capabilities" hidden>
          <p class="m-lede">
            Every workspace on the platform is listed here. Free members keep the backtest and the
            operating manual — the rest opens with a subscription. Documentation and source are never
            exposed to members.
          </p>
          <div class="m-cap-grid" id="mCapGrid"></div>
        </section>

        <!-- ============ COPILOT ============ -->
        <section data-view-panel="copilot" aria-label="AI Copilot" hidden>
          <div class="m-panel m-chat-panel">
            <div class="m-panel-head">
              <h2>MCP copilot</h2>
              <div class="m-chat-tools">
                <code class="m-mono">/mcp</code>
                <button type="button" class="m-link" id="mChatClear">Clear</button>
              </div>
            </div>
            <div class="m-chat-log" id="mChatLog" aria-live="polite"></div>
            <form class="m-chat-form" id="mChatForm">
              <textarea id="mChatInput" rows="2" placeholder="Ask about signals, COT, this week’s releases, performance…" aria-label="Message the copilot"></textarea>
              <button type="submit" class="m-send">Send</button>
            </form>
            <div class="m-chat-chips">
              <button type="button" data-prompt="Show pending signals.">Pending signals</button>
              <button type="button" data-prompt="Summarize CFTC positioning and open interest.">COT / OI</button>
              <button type="button" data-prompt="What did the desk publish most recently?">Latest analysis</button>
            </div>
          </div>
        </section>

        <!-- ============ NOTIFICATIONS ============ -->
        <section data-view-panel="notifications" aria-label="Notifications" hidden>
          <div class="m-panel">
            <div class="m-panel-head">
              <h2>Notification centre</h2>
              <button type="button" class="m-link" id="mMarkRead">Mark all read</button>
            </div>
            <div id="mNotifList" class="m-notif-list"></div>
          </div>
        </section>

        <!-- ============ ACCOUNT ============ -->
        <section data-view-panel="account" aria-label="Account and plan" hidden>
          <div class="m-grid-2">
            <div class="m-panel">
              <div class="m-panel-head"><h2>Profile</h2></div>
              <dl class="m-dl">
                <div><dt>Name</dt><dd id="mName2">—</dd></div>
                <div><dt>Username</dt><dd id="mHandle2">—</dd></div>
                <div><dt>Email</dt><dd id="mEmail2">—</dd></div>
                <div><dt>Session</dt><dd class="m-ok">Active · private</dd></div>
                <div><dt>MCP endpoint</dt><dd class="m-inline"><code class="m-mono" id="mMcpEndpoint">https://trading-llc-mcp.mahdi-t8256.workers.dev/mcp</code><button type="button" class="m-link" id="mMcpCopy">copy</button></dd></div>
              </dl>
            </div>

            <div class="m-panel">
              <div class="m-panel-head"><h2>Plan</h2></div>
              <p class="m-member-note" id="mMemberNote" hidden>
                Your subscription is active. The full toolkit — live desk, signals, indicator export,
                OI/COT, analytical engine and custom news AI — is unlocked.
              </p>
              <button type="button" class="m-cta" id="mTrialBtn">Start 7-day trial</button>
              <div class="m-plan-grid" id="mPlanGrid">
                <article class="m-plan">
                  <span class="m-mono">MONTHLY</span>
                  <b>$149</b>
                  <span class="m-plan-cad">per month</span>
                  <p>Full toolkit, one cloud bridge instance.</p>
                  <button type="button" class="m-plan-btn" data-plan="monthly">Request monthly</button>
                </article>
                <article class="m-plan m-plan-best">
                  <span class="m-mono">ANNUAL · BEST</span>
                  <b>$1,290</b>
                  <span class="m-plan-cad">per year</span>
                  <p>Two months free, priority provisioning.</p>
                  <button type="button" class="m-plan-btn" data-plan="annual">Request annual</button>
                </article>
              </div>
              <p class="m-fine">
                Activation is performed by the desk after payment. Requests appear in the owner console
                immediately; nothing is charged from this page.
              </p>
            </div>
          </div>
        </section>
      </main>
    </div>

    <script>
      import { mountMember } from '../scripts/member.ts';
      mountMember();
    </script>

    <style>
      .member-body {
        margin: 0;
        min-height: 100vh;
        background:
          radial-gradient(900px 500px at 85% -10%, rgba(225, 29, 72, 0.16), transparent 60%),
          radial-gradient(700px 500px at 0% 100%, rgba(120, 20, 50, 0.14), transparent 60%),
          #070406;
        color: #f6f2f4;
        font-family: Inter, system-ui, sans-serif;
      }
      .m-shell {
        display: grid;
        grid-template-columns: 268px minmax(0, 1fr);
        min-height: 100vh;
      }
      .m-side {
        position: sticky;
        top: 0;
        align-self: start;
        height: 100vh;
        display: flex;
        flex-direction: column;
        gap: 18px;
        padding: 22px 18px;
        border-right: 1px solid rgba(255, 255, 255, 0.07);
        background: linear-gradient(180deg, rgba(18, 10, 14, 0.96), rgba(8, 4, 6, 0.96));
        backdrop-filter: blur(10px);
      }
      .m-brand img { width: 168px; height: auto; display: block; }
      .m-profile {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.03);
      }
      .m-avatar {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        display: grid;
        place-items: center;
        background: linear-gradient(135deg, #e11d48, #7f1d3a);
        font-family: 'Playfair Display', serif;
        font-size: 16px;
        font-weight: 700;
      }
      .m-profile-txt { display: flex; flex-direction: column; min-width: 0; }
      .m-profile-txt b { font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .m-profile-txt span { font-family: 'JetBrains Mono', monospace; font-size: 10px; color: #a5979d; }
      .m-tier {
        margin-left: auto;
        font-family: 'JetBrains Mono', monospace;
        font-size: 9px;
        letter-spacing: 0.12em;
        padding: 4px 7px;
        border-radius: 999px;
        border: 1px solid rgba(255, 255, 255, 0.16);
        color: #cbbfc4;
      }
      .m-tier[data-tier='paid'] {
        border-color: rgba(52, 211, 153, 0.5);
        color: #6ee7b7;
        background: rgba(16, 185, 129, 0.1);
      }
      .m-nav { display: flex; flex-direction: column; gap: 4px; }
      .m-nav-btn {
        display: flex;
        align-items: center;
        gap: 10px;
        width: 100%;
        padding: 10px 12px;
        border-radius: 10px;
        border: 1px solid transparent;
        background: none;
        color: #cbbfc4;
        font: inherit;
        font-size: 13px;
        text-align: left;
        cursor: pointer;
        transition: 0.16s;
      }
      .m-nav-btn:hover { background: rgba(255, 255, 255, 0.05); color: #fff; }
      .m-nav-btn.active {
        background: linear-gradient(90deg, rgba(225, 29, 72, 0.18), rgba(225, 29, 72, 0.04));
        border-color: rgba(225, 29, 72, 0.35);
        color: #fff;
      }
      .m-nav-ic { color: #e11d48; font-size: 11px; }
      .m-nav-badge {
        margin-left: auto;
        min-width: 18px;
        height: 18px;
        padding: 0 5px;
        border-radius: 999px;
        background: #e11d48;
        color: #fff;
        font-size: 10px;
        font-family: 'JetBrains Mono', monospace;
        display: grid;
        place-items: center;
      }
      .m-side-plan {
        margin-top: auto;
        padding: 12px;
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        background: rgba(255, 255, 255, 0.03);
      }
      .m-side-plan-head { display: flex; justify-content: space-between; align-items: baseline; }
      .m-side-plan-head span {
        font-family: 'JetBrains Mono', monospace;
        font-size: 9px;
        letter-spacing: 0.18em;
        color: #8d7f85;
      }
      .m-side-plan-head b { font-size: 12px; }
      .m-side-plan-time { font-family: 'JetBrains Mono', monospace; font-size: 10px; color: #a5979d; margin-top: 4px; }
      .m-meter { height: 4px; border-radius: 999px; background: rgba(255, 255, 255, 0.08); margin-top: 10px; overflow: hidden; }
      .m-meter i { display: block; height: 100%; width: 0; background: linear-gradient(90deg, #e11d48, #f59e0b); transition: width 0.5s; }
      .m-side-foot { display: flex; justify-content: space-between; align-items: center; }
      .m-side-foot a,
      .m-side-foot button {
        background: none;
        border: none;
        color: #8d7f85;
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        cursor: pointer;
        text-decoration: none;
      }
      .m-side-foot a:hover,
      .m-side-foot button:hover { color: #e11d48; }

      .m-main { padding: 30px clamp(18px, 4vw, 44px) 60px; min-width: 0; }
      .m-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; margin-bottom: 24px; }
      .m-kicker {
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        letter-spacing: 0.22em;
        color: #e11d48;
        text-transform: uppercase;
      }
      .m-top h1 {
        font-family: 'Playfair Display', serif;
        font-size: clamp(28px, 4vw, 40px);
        margin: 8px 0 4px;
        color: #fff;
      }
      .m-greeting { margin: 0; color: #a5979d; font-size: 13px; }
      .m-top-right { display: flex; align-items: center; gap: 10px; }
      .m-bell {
        position: relative;
        width: 38px;
        height: 38px;
        border-radius: 11px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        background: rgba(255, 255, 255, 0.04);
        color: #d8ccd1;
        cursor: pointer;
      }
      .m-bell-dot {
        position: absolute;
        top: 7px;
        right: 8px;
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #e11d48;
      }
      .m-chip {
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        letter-spacing: 0.14em;
        padding: 9px 12px;
        border-radius: 999px;
        border: 1px solid rgba(255, 255, 255, 0.14);
        color: #d8ccd1;
      }

      .m-stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; margin-bottom: 18px; }
      .m-stat {
        padding: 16px;
        border-radius: 14px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        background: linear-gradient(160deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.015));
      }
      .m-stat span {
        display: block;
        font-family: 'JetBrains Mono', monospace;
        font-size: 9px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: #8d7f85;
        margin-bottom: 8px;
      }
      .m-stat b { font-size: 22px; color: #fff; font-family: 'Playfair Display', serif; }

      .m-panel {
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 16px;
        background: rgba(15, 9, 12, 0.72);
        padding: 18px;
        margin-bottom: 16px;
      }
      .m-panel-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 14px; }
      .m-panel-head h2 { font-family: 'Playfair Display', serif; font-size: 18px; margin: 0; color: #fff; }
      .m-mono { font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.12em; color: #8d7f85; }
      .m-link {
        background: none;
        border: none;
        color: #e11d48;
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        letter-spacing: 0.08em;
        cursor: pointer;
        padding: 0;
      }
      .m-link:hover { color: #fb7185; }
      .m-quick { display: flex; flex-wrap: wrap; gap: 8px; }
      .m-quick button {
        padding: 10px 14px;
        border-radius: 10px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        background: rgba(255, 255, 255, 0.04);
        color: #e9e0e4;
        font: inherit;
        font-size: 12px;
        cursor: pointer;
      }
      .m-quick button:hover { border-color: rgba(225, 29, 72, 0.5); color: #fff; }
      .m-empty { color: #8d7f85; font-size: 13px; margin: 0; }

      .m-lede { color: #a5979d; font-size: 13.5px; line-height: 1.7; max-width: 720px; margin: 0 0 18px; }
      .m-cap-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 12px; }
      .m-cap {
        text-align: left;
        padding: 16px;
        border-radius: 14px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        background: rgba(255, 255, 255, 0.03);
        color: inherit;
        font: inherit;
        cursor: pointer;
        transition: 0.18s;
      }
      .m-cap:hover { transform: translateY(-2px); border-color: rgba(225, 29, 72, 0.45); }
      .m-cap.locked { opacity: 0.78; }
      .m-cap-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
      .m-cap-state { font-family: 'JetBrains Mono', monospace; font-size: 8.5px; letter-spacing: 0.14em; color: #8d7f85; }
      .m-cap.open .m-cap-state { color: #6ee7b7; }
      .m-cap-ic { font-size: 12px; }
      .m-cap h3 { font-size: 15px; margin: 0 0 6px; color: #fff; }
      .m-cap p { font-size: 12px; line-height: 1.6; color: #a5979d; margin: 0; }

      .m-notif-list { display: flex; flex-direction: column; gap: 8px; }
      .m-notif {
        display: grid;
        grid-template-columns: 92px 1fr;
        gap: 12px;
        padding: 12px;
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.07);
        background: rgba(255, 255, 255, 0.02);
      }
      .m-notif.unread { border-color: rgba(225, 29, 72, 0.4); background: rgba(225, 29, 72, 0.06); }
      .m-notif-k {
        font-family: 'JetBrains Mono', monospace;
        font-size: 9px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #e11d48;
        padding-top: 2px;
      }
      .m-notif-body b { font-size: 13px; color: #fff; }
      .m-notif-body p { font-size: 12px; color: #b3a6ac; margin: 4px 0; line-height: 1.6; }
      .m-notif-body time { font-family: 'JetBrains Mono', monospace; font-size: 9px; color: #75686e; }

      .m-chat-log {
        height: min(52vh, 440px);
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 10px;
        padding: 4px 2px 14px;
      }
      .m-msg {
        max-width: min(760px, 92%);
        padding: 12px 14px;
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        background: rgba(255, 255, 255, 0.03);
      }
      .m-msg.user {
        align-self: flex-end;
        background: rgba(225, 29, 72, 0.12);
        border-color: rgba(225, 29, 72, 0.32);
      }
      .m-msg-k { font-family: 'JetBrains Mono', monospace; font-size: 8.5px; letter-spacing: 0.16em; color: #8d7f85; margin-bottom: 6px; }
      .m-msg-text { font-size: 12.5px; line-height: 1.65; white-space: pre-wrap; overflow-wrap: anywhere; color: #e9e0e4; }
      .m-msg-meta { font-family: 'JetBrains Mono', monospace; font-size: 8.5px; color: #75686e; margin-top: 6px; }
      .m-chat-form { display: flex; gap: 8px; align-items: flex-end; }
      .m-chat-form textarea {
        flex: 1;
        resize: none;
        padding: 11px 12px;
        border-radius: 11px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        background: rgba(0, 0, 0, 0.35);
        color: #fff;
        font: inherit;
        font-size: 13px;
        outline: none;
      }
      .m-chat-form textarea:focus { border-color: rgba(225, 29, 72, 0.55); }
      .m-send {
        padding: 11px 18px;
        border-radius: 11px;
        border: none;
        background: linear-gradient(135deg, #e11d48, #be185d);
        color: #fff;
        font: inherit;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
      }
      .m-chat-chips, .m-chat-tools { display: flex; gap: 8px; align-items: center; }
      .m-chat-chips { margin-top: 10px; flex-wrap: wrap; }
      .m-chat-chips button {
        padding: 7px 11px;
        border-radius: 999px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        background: none;
        color: #b3a6ac;
        font: inherit;
        font-size: 11px;
        cursor: pointer;
      }
      .m-chat-chips button:hover { color: #fff; border-color: rgba(225, 29, 72, 0.5); }

      .m-grid-2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px; }
      .m-grid-2 .m-panel { margin-bottom: 0; }
      .m-dl { margin: 0; display: flex; flex-direction: column; gap: 10px; }
      .m-dl > div { display: flex; justify-content: space-between; gap: 14px; border-bottom: 1px solid rgba(255, 255, 255, 0.06); padding-bottom: 9px; }
      .m-dl dt { font-family: 'JetBrains Mono', monospace; font-size: 9.5px; letter-spacing: 0.14em; text-transform: uppercase; color: #8d7f85; }
      .m-dl dd { margin: 0; font-size: 12.5px; color: #e9e0e4; text-align: right; overflow-wrap: anywhere; }
      .m-inline { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; justify-content: flex-end; }
      .m-ok { color: #6ee7b7 !important; }
      .m-cta {
        width: 100%;
        padding: 12px;
        border-radius: 11px;
        border: 1px solid rgba(225, 29, 72, 0.45);
        background: rgba(225, 29, 72, 0.12);
        color: #fda4af;
        font: inherit;
        font-size: 12.5px;
        cursor: pointer;
        margin-bottom: 12px;
      }
      .m-plan-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 10px; }
      .m-plan {
        padding: 14px;
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        background: rgba(255, 255, 255, 0.03);
        display: flex;
        flex-direction: column;
        gap: 4px;
      }
      .m-plan-best { border-color: rgba(225, 29, 72, 0.4); background: rgba(225, 29, 72, 0.07); }
      .m-plan b { font-family: 'Playfair Display', serif; font-size: 24px; color: #fff; }
      .m-plan-cad { font-family: 'JetBrains Mono', monospace; font-size: 9px; color: #8d7f85; }
      .m-plan p { font-size: 11.5px; color: #a5979d; line-height: 1.5; margin: 6px 0 10px; }
      .m-plan-btn {
        margin-top: auto;
        padding: 9px;
        border-radius: 9px;
        border: 1px solid rgba(255, 255, 255, 0.14);
        background: rgba(255, 255, 255, 0.05);
        color: #fff;
        font: inherit;
        font-size: 11.5px;
        cursor: pointer;
      }
      .m-plan-btn:hover { background: rgba(225, 29, 72, 0.2); border-color: rgba(225, 29, 72, 0.45); }
      .m-member-note { font-size: 12.5px; line-height: 1.7; color: #b3a6ac; margin: 0 0 14px; }
      .m-fine { font-size: 10.5px; line-height: 1.6; color: #75686e; margin: 12px 0 0; }

      #memberToast {
        position: fixed;
        left: 50%;
        bottom: 22px;
        transform: translate(-50%, 16px);
        padding: 11px 16px;
        border-radius: 10px;
        border: 1px solid rgba(225, 29, 72, 0.4);
        background: rgba(20, 11, 15, 0.98);
        color: #f7e9ee;
        font-size: 12.5px;
        opacity: 0;
        pointer-events: none;
        transition: 0.22s;
        z-index: 50;
      }
      #memberToast.show { opacity: 1; transform: translate(-50%, 0); }

      @media (max-width: 900px) {
        .m-shell { grid-template-columns: 1fr; }
        .m-side {
          position: relative;
          height: auto;
          flex-direction: column;
          border-right: none;
          border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }
        .m-nav { flex-direction: row; overflow-x: auto; }
        .m-nav-btn { white-space: nowrap; width: auto; }
        .m-side-plan, .m-side-foot { display: none; }
        .m-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      }
    </style>
  </body>
</html>
