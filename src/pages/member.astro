---
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Vaelor member dashboard — plan, capabilities, AI copilot and notifications." />
    <meta name="color-scheme" content="dark" />
    <title>Member dashboard — Vaelor Trading LLC</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Playfair+Display:ital,wght@0,600;0,700;1,400&display=swap" rel="stylesheet" />
  </head>
  <body class="member-body">
    <div id="memberPage" class="m-shell">
      <!-- ===================== SIDEBAR ===================== -->
      <aside class="m-side" aria-label="Member navigation">
        <a class="m-brand" href="/" aria-label="Vaelor Trading Intelligence — home">
          <img src="/vaelor-trading-intelligence.png" alt="Vaelor Trading Intelligence" width="760" height="253" />
        </a>

        <div class="m-profile">
          <div class="m-avatar" id="mAvatar">—</div>
          <div class="m-profile-txt">
            <b id="mName">Member</b>
            <span id="mHandle">@member</span>
          </div>
          <span class="m-tier" id="mTierBadge" data-tier="free">FREE</span>
        </div>

        <nav class="m-nav" aria-label="Dashboard sections">
          <button type="button" class="m-nav-btn active" data-view-link="overview" aria-current="page">
            <span class="m-nav-ic" aria-hidden="true">I.</span> Overview
          </button>
          <button type="button" class="m-nav-btn" data-view-link="capabilities">
            <span class="m-nav-ic" aria-hidden="true">II.</span> Capabilities
          </button>
          <button type="button" class="m-nav-btn" data-view-link="copilot">
            <span class="m-nav-ic" aria-hidden="true">III.</span> AI Copilot
          </button>
          <button type="button" class="m-nav-btn" data-view-link="notifications">
            <span class="m-nav-ic" aria-hidden="true">IV.</span> Notifications
            <span class="m-nav-badge" data-notif-count hidden></span>
          </button>
          <button type="button" class="m-nav-btn" data-view-link="account">
            <span class="m-nav-ic" aria-hidden="true">V.</span> Account &amp; plan
          </button>
        </nav>

        <div class="m-side-plan">
          <div class="m-side-plan-head">
            <span>Plan</span>
            <b id="mPlanName">Free tier</b>
          </div>
          <div class="m-side-plan-time" id="mPlanTime">No expiry</div>
          <div class="m-meter" aria-hidden="true"><i id="mPlanBar"></i></div>
        </div>

        <div class="m-side-foot">
          <a href="/">← Return to the house</a>
          <button type="button" id="mSignOut">Sign out</button>
        </div>
      </aside>

      <!-- ===================== MAIN ===================== -->
      <main class="m-main">
        <header class="m-top">
          <div>
            <div class="m-kicker">Member Terminal · Private</div>
            <h1 id="mViewTitle">Overview</h1>
            <p class="m-greeting" id="mGreeting">Welcome back.</p>
          </div>
          <div class="m-top-right">
            <button type="button" class="m-bell" data-view-link="notifications" aria-label="Notifications">
              <span aria-hidden="true">◎</span>
              <span class="m-bell-dot" data-notif-count hidden></span>
            </button>
            <span class="m-chip" id="mTierStat">Free</span>
          </div>
        </header>

        <!-- ============ OVERVIEW ============ -->
        <section data-view-panel="overview" aria-label="Overview">
          <div class="m-stats">
            <div class="m-stat">
              <span>Membership</span>
              <b id="mTierStat2">—</b>
            </div>
            <div class="m-stat">
              <span>Time remaining</span>
              <b id="mTimeStat">—</b>
            </div>
            <div class="m-stat">
              <span>Features unlocked</span>
              <b><span id="mUnlockedCount">0</span> <em>/ <span id="mCapTotal">13</span></em></b>
            </div>
            <div class="m-stat">
              <span>Locked by plan</span>
              <b id="mLockedCount">0</b>
            </div>
          </div>

          <div class="m-panel">
            <div class="m-panel-head">
              <h2>Quick actions</h2>
              <span class="m-mono">MCP · LIVE DATA</span>
            </div>
            <div class="m-quick">
              <button type="button" data-prompt="What is in the signal queue right now?">Signal queue</button>
              <button type="button" data-prompt="Show this week's high impact macro releases.">This week's news</button>
              <button type="button" data-prompt="How is measured performance across strategies?">Measured performance</button>
              <button type="button" data-view-link="capabilities">Open capabilities</button>
            </div>
          </div>

          <div class="m-panel">
            <div class="m-panel-head">
              <h2>Recent notifications</h2>
              <button type="button" class="m-link" data-view-link="notifications">View all →</button>
            </div>
            <div id="mNotifPreview" class="m-notif-preview">
              <p class="m-empty">Notifications appear as signals, AI results and plan updates arrive.</p>
            </div>
          </div>
        </section>

        <!-- ============ CAPABILITIES ============ -->
        <section data-view-panel="capabilities" aria-label="Capabilities" hidden>
          <p class="m-lede">
            Every workspace on the platform is listed here. Free members keep the backtest and the
            operating manual — the rest opens with a subscription. Documentation and source are never
            exposed to members.
          </p>
          <div class="m-cap-grid" id="mCapGrid"></div>
        </section>

        <!-- ============ COPILOT ============ -->
        <section data-view-panel="copilot" aria-label="AI Copilot" hidden>
          <div class="m-panel m-chat-panel">
            <div class="m-panel-head">
              <h2>MCP copilot</h2>
              <div class="m-chat-tools">
                <code class="m-mono">/mcp</code>
                <button type="button" class="m-link" id="mChatClear">Clear</button>
              </div>
            </div>
            <div class="m-chat-log" id="mChatLog" aria-live="polite"></div>
            <form class="m-chat-form" id="mChatForm">
              <textarea id="mChatInput" rows="2" placeholder="Ask about signals, COT, this week's releases, performance…" aria-label="Message the copilot"></textarea>
              <button type="submit" class="m-send">Send</button>
            </form>
            <div class="m-chat-chips">
              <button type="button" data-prompt="Show pending signals.">Pending signals</button>
              <button type="button" data-prompt="Summarize CFTC positioning and open interest.">COT / OI</button>
              <button type="button" data-prompt="What did the desk publish most recently?">Latest analysis</button>
            </div>
          </div>
        </section>

        <!-- ============ NOTIFICATIONS ============ -->
        <section data-view-panel="notifications" aria-label="Notifications" hidden>
          <div class="m-panel">
            <div class="m-panel-head">
              <h2>Notification centre</h2>
              <button type="button" class="m-link" id="mMarkRead">Mark all read</button>
            </div>
            <div id="mNotifList" class="m-notif-list"></div>
          </div>
        </section>

        <!-- ============ ACCOUNT ============ -->
        <section data-view-panel="account" aria-label="Account and plan" hidden>
          <div class="m-grid-2">
            <div class="m-panel">
              <div class="m-panel-head"><h2>Profile</h2></div>
              <dl class="m-dl">
                <div><dt>Name</dt><dd id="mName2">—</dd></div>
                <div><dt>Username</dt><dd id="mHandle2">—</dd></div>
                <div><dt>Email</dt><dd id="mEmail2">—</dd></div>
                <div><dt>Session</dt><dd class="m-ok">Active · private</dd></div>
                <div><dt>MCP endpoint</dt><dd class="m-inline"><code class="m-mono" id="mMcpEndpoint">https://trading-llc-mcp.mahdi-t8256.workers.dev/mcp</code><button type="button" class="m-link" id="mMcpCopy">copy</button></dd></div>
              </dl>
            </div>

            <div class="m-panel">
              <div class="m-panel-head"><h2>Plan</h2></div>
              <p class="m-member-note" id="mMemberNote" hidden>
                Your subscription is active. The full toolkit — live desk, signals, indicator export,
                OI/COT, analytical engine and custom news AI — is unlocked.
              </p>
              <button type="button" class="m-cta" id="mTrialBtn">Start 7-day trial</button>
              <div class="m-plan-grid" id="mPlanGrid">
                <article class="m-plan">
                  <span class="m-mono">Monthly</span>
                  <b>$149</b>
                  <span class="m-plan-cad">per month</span>
                  <p>Full toolkit, one cloud bridge instance.</p>
                  <button type="button" class="m-plan-btn" data-plan="monthly">Request monthly</button>
                </article>
                <article class="m-plan m-plan-best">
                  <span class="m-mono">Annual · Best</span>
                  <b>$1,290</b>
                  <span class="m-plan-cad">per year</span>
                  <p>Two months free, priority provisioning.</p>
                  <button type="button" class="m-plan-btn" data-plan="annual">Request annual</button>
                </article>
              </div>
              <p class="m-fine">
                Activation is performed by the desk after payment. Requests appear in the owner console
                immediately; nothing is charged from this page.
              </p>
            </div>
          </div>
        </section>
      </main>
    </div>

    <script>
      import { mountMember } from '../scripts/member.ts';
      mountMember();
    </script>

    <style>
      /* ────────────────────────────────────────────────────────────
         Vaelor member terminal · old-money luxury
         Warm black · oxblood · ivory · antique gold · serif numerals
         ──────────────────────────────────────────────────────────── */
      .member-body {
        margin: 0;
        min-height: 100vh;
        background:
          radial-gradient(1100px 600px at 88% -12%, rgba(142, 42, 56, 0.20), transparent 60%),
          radial-gradient(800px 600px at -10% 110%, rgba(60, 44, 16, 0.16), transparent 60%),
          #0b0907;
        color: #efe7d8;
        font-family: Inter, system-ui, sans-serif;
      }
      .m-shell {
        display: grid;
        grid-template-columns: 272px minmax(0, 1fr);
        min-height: 100vh;
      }
      .m-side {
        position: sticky;
        top: 0;
        align-self: start;
        height: 100vh;
        display: flex;
        flex-direction: column;
        gap: 18px;
        padding: 24px 20px;
        border-right: 1px solid rgba(239, 231, 216, 0.09);
        background: linear-gradient(180deg, rgba(24, 17, 13, 0.98), rgba(12, 9, 7, 0.98));
      }
      .m-brand img { width: 150px; height: auto; display: block; opacity: 0.9; }
      .m-profile {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 13px 14px;
        border: 1px solid rgba(239, 231, 216, 0.11);
        border-radius: 13px;
        background: rgba(255, 255, 255, 0.028);
      }
      .m-avatar {
        width: 42px;
        height: 42px;
        flex: 0 0 42px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        border: 1px solid rgba(201, 162, 75, 0.45);
        background: radial-gradient(circle at 30% 30%, #8e2a38, #4a131c);
        color: #f3e7cf;
        font-family: 'Playfair Display', serif;
        font-size: 16px;
        font-weight: 700;
      }
      .m-profile-txt { display: flex; flex-direction: column; min-width: 0; }
      .m-profile-txt b { font-family: 'Playfair Display', serif; font-size: 14.5px; color: #f6efdf; }
      .m-profile-txt span { font-family: 'JetBrains Mono', monospace; font-size: 9.5px; color: #9a8d78; }
      .m-tier {
        margin-left: auto;
        font-family: 'JetBrains Mono', monospace;
        font-size: 8.5px;
        letter-spacing: 0.14em;
        padding: 5px 8px;
        border-radius: 999px;
        border: 1px solid rgba(201, 162, 75, 0.4);
        color: #e3c98f;
        background: rgba(201, 162, 75, 0.07);
      }
      .m-nav { display: flex; flex-direction: column; gap: 2px; }
      .m-nav-btn {
        display: flex;
        align-items: center;
        gap: 11px;
        width: 100%;
        padding: 10px 12px;
        border-radius: 10px;
        border: 1px solid transparent;
        background: none;
        color: #b7ab97;
        font-family: 'Inter', sans-serif;
        font-size: 12.5px;
        font-weight: 500;
        text-align: left;
        cursor: pointer;
        transition: background 0.18s, color 0.18s;
      }
      .m-nav-btn:hover { background: rgba(239, 231, 216, 0.045); color: #f6efdf; }
      .m-nav-btn.active {
        background: rgba(142, 42, 56, 0.14);
        border-color: rgba(142, 42, 56, 0.4);
        color: #f6efdf;
      }
      .m-nav-ic { font-family: 'Playfair Display', serif; font-size: 12px; color: #c9a24b; }
      .m-nav-badge {
        margin-left: auto;
        min-width: 18px;
        height: 18px;
        padding: 0 5px;
        border-radius: 999px;
        background: #8e2a38;
        color: #f6efdf;
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        display: grid;
        place-items: center;
      }
      .m-side-plan {
        margin-top: auto;
        padding: 14px;
        border-radius: 13px;
        border: 1px solid rgba(239, 231, 216, 0.1);
        background: rgba(255, 255, 255, 0.025);
      }
      .m-side-plan-head { display: flex; justify-content: space-between; align-items: baseline; }
      .m-side-plan-head span {
        font-family: 'JetBrains Mono', monospace;
        font-size: 8.5px;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: #8d8170;
      }
      .m-side-plan-head b { font-family: 'Playfair Display', serif; font-size: 14px; color: #f6efdf; }
      .m-side-plan-time { font-family: 'JetBrains Mono', monospace; font-size: 9.5px; color: #9a8d78; margin-top: 5px; }
      .m-meter { height: 3px; border-radius: 999px; background: rgba(239, 231, 216, 0.1); margin-top: 11px; overflow: hidden; }
      .m-meter i { display: block; height: 100%; width: 0; background: linear-gradient(90deg, #c9a24b, #e6cf9a); transition: width 0.5s; }
      .m-side-foot { display: flex; justify-content: space-between; align-items: center; }
      .m-side-foot a, .m-side-foot button {
        background: none;
        border: none;
        color: #8d8170;
        font-family: 'JetBrains Mono', monospace;
        font-size: 9px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        cursor: pointer;
        text-decoration: none;
      }
      .m-side-foot a:hover, .m-side-foot button:hover { color: #c9a24b; }

      .m-main { padding: 34px clamp(20px, 4vw, 46px) 70px; min-width: 0; }
      .m-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; margin-bottom: 28px; }
      .m-kicker {
        font-family: 'JetBrains Mono', monospace;
        font-size: 9.5px;
        letter-spacing: 0.24em;
        text-transform: uppercase;
        color: #c9a24b;
      }
      .m-top h1 {
        font-family: 'Playfair Display', serif;
        font-size: clamp(30px, 4vw, 42px);
        margin: 10px 0 6px;
        color: #f6efdf;
        font-weight: 600;
      }
      .m-greeting { margin: 0; color: #9a8d78; font-size: 12.5px; font-style: italic; font-family: 'Playfair Display', serif; }
      .m-top-right { display: flex; align-items: center; gap: 10px; }
      .m-bell {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        border: 1px solid rgba(239, 231, 216, 0.16);
        background: rgba(255, 255, 255, 0.03);
        color: #efe7d8;
        cursor: pointer;
        font-size: 14px;
      }
      .m-bell-dot {
        position: absolute;
        top: 9px;
        right: 10px;
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #8e2a38;
        border: 1px solid #efe7d8;
      }
      .m-chip {
        font-family: 'JetBrains Mono', monospace;
        font-size: 9px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        padding: 9px 12px;
        border-radius: 999px;
        border: 1px solid rgba(201, 162, 75, 0.35);
        color: #e3c98f;
        background: rgba(201, 162, 75, 0.06);
      }

      .m-stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; margin-bottom: 18px; }
      .m-stat {
        padding: 17px 18px;
        border-radius: 14px;
        border: 1px solid rgba(239, 231, 216, 0.1);
        border-top: 2px solid rgba(201, 162, 75, 0.5);
        background: linear-gradient(165deg, rgba(255, 255, 255, 0.032), rgba(255, 255, 255, 0.008));
      }
      .m-stat span {
        display: block;
        font-family: 'JetBrains Mono', monospace;
        font-size: 8.5px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: #8d8170;
        margin-bottom: 10px;
      }
      .m-stat b { font-size: 22px; color: #f6efdf; font-family: 'Playfair Display', serif; font-weight: 600; }
      .m-stat b em { font-style: normal; font-size: 13px; color: #8d8170; }

      .m-panel {
        border: 1px solid rgba(239, 231, 216, 0.1);
        border-radius: 15px;
        background: linear-gradient(180deg, rgba(28, 21, 16, 0.55), rgba(17, 13, 10, 0.55));
        padding: 20px;
        margin-bottom: 16px;
      }
      .m-panel::before {
        content: '';
        display: block;
        width: 34px;
        height: 2px;
        background: linear-gradient(90deg, #8e2a38, #c9a24b);
        border-radius: 2px;
        margin-bottom: 14px;
      }
      .m-panel-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 15px; }
      .m-panel-head h2 { font-family: 'Playfair Display', serif; font-size: 18px; font-weight: 600; margin: 0; color: #f6efdf; }
      .m-mono { font-family: 'JetBrains Mono', monospace; font-size: 9px; letter-spacing: 0.16em; text-transform: uppercase; color: #8d8170; }
      .m-link {
        background: none;
        border: none;
        color: #c9a24b;
        font-family: 'JetBrains Mono', monospace;
        font-size: 9.5px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        cursor: pointer;
        padding: 0;
      }
      .m-link:hover { color: #e6cf9a; }
      .m-quick { display: flex; flex-wrap: wrap; gap: 9px; }
      .m-quick button {
        padding: 11px 16px;
        border-radius: 999px;
        border: 1px solid rgba(239, 231, 216, 0.14);
        background: rgba(255, 255, 255, 0.03);
        color: #e9dfc9;
        font-family: 'Inter', sans-serif;
        font-size: 12px;
        cursor: pointer;
        transition: 0.18s;
      }
      .m-quick button:hover { border-color: rgba(201, 162, 75, 0.55); color: #f6efdf; background: rgba(201, 162, 75, 0.06); }
      .m-empty { color: #8d8170; font-size: 12.5px; margin: 0; font-style: italic; font-family: 'Playfair Display', serif; }

      .m-lede { color: #b7ab97; font-size: 13.5px; line-height: 1.8; max-width: 760px; margin: 0 0 20px; font-family: 'Inter', sans-serif; }
      .m-cap-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 12px; }
      .m-cap {
        text-align: left;
        padding: 17px 18px;
        border-radius: 13px;
        border: 1px solid rgba(239, 231, 216, 0.11);
        border-left: 3px solid rgba(142, 42, 56, 0.65);
        background: rgba(255, 255, 255, 0.025);
        color: inherit;
        font: inherit;
        cursor: pointer;
        transition: 0.18s;
      }
      .m-cap.open { border-left-color: #c9a24b; }
      .m-cap:hover { transform: translateY(-2px); border-color: rgba(201, 162, 75, 0.45); }
      .m-cap.locked { opacity: 0.8; }
      .m-cap-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 11px; }
      .m-cap-state { font-family: 'JetBrains Mono', monospace; font-size: 8px; letter-spacing: 0.16em; text-transform: uppercase; color: #8d8170; }
      .m-cap.open .m-cap-state { color: #c9a24b; }
      .m-cap-ic { font-size: 11px; color: #c9a24b; }
      .m-cap h3 { font-family: 'Playfair Display', serif; font-size: 16.5px; margin: 0 0 6px; color: #f6efdf; font-weight: 600; }
      .m-cap p { font-size: 12px; line-height: 1.65; color: #a89c87; margin: 0; }

      .m-notif-list { display: flex; flex-direction: column; gap: 10px; }
      .m-notif {
        display: grid;
        grid-template-columns: 96px 1fr;
        gap: 12px;
        padding: 13px 15px;
        border-radius: 12px;
        border: 1px solid rgba(239, 231, 216, 0.09);
        background: rgba(255, 255, 255, 0.02);
      }
      .m-notif.unread { border-color: rgba(142, 42, 56, 0.55); background: rgba(142, 42, 56, 0.07); }
      .m-notif-k {
        font-family: 'JetBrains Mono', monospace;
        font-size: 8.5px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #c9a24b;
        padding-top: 3px;
      }
      .m-notif-body b { font-size: 13px; color: #f6efdf; font-weight: 600; }
      .m-notif-body p { font-size: 12px; color: #b7ab97; margin: 4px 0; line-height: 1.6; }
      .m-notif-body time { font-family: 'JetBrains Mono', monospace; font-size: 8.5px; color: #8d8170; }
      .m-notif-preview { display: flex; flex-direction: column; gap: 10px; }

      .m-chat-log {
        height: min(52vh, 440px);
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 11px;
        padding: 4px 2px 14px;
      }
      .m-msg { max-width: min(780px, 92%); padding: 13px 15px; border-radius: 12px; border: 1px solid rgba(239, 231, 216, 0.1); border-left: 3px solid rgba(201, 162, 75, 0.55); background: rgba(255, 255, 255, 0.028); }
      .m-msg.user { align-self: flex-end; border-left: none; border-right: 3px solid rgba(142, 42, 56, 0.7); background: rgba(142, 42, 56, 0.1); }
      .m-msg-k { font-family: 'JetBrains Mono', monospace; font-size: 8px; letter-spacing: 0.16em; text-transform: uppercase; color: #8d8170; margin-bottom: 6px; }
      .m-msg-text { font-size: 12.5px; line-height: 1.7; white-space: pre-wrap; overflow-wrap: anywhere; color: #ede4cf; font-family: 'Inter', sans-serif; }
      .m-msg-meta { font-family: 'JetBrains Mono', monospace; font-size: 8px; color: #8d8170; margin-top: 6px; letter-spacing: 0.08em; }
      .m-chat-form { display: flex; gap: 9px; align-items: flex-end; }
      .m-chat-form textarea {
