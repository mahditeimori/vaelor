---
import BaseLayout from '../layouts/BaseLayout.astro';

const WORKER = 'https://trading-llc-mcp.mahdi-t8256.workers.dev';
---

<BaseLayout
  title="News · Economic Calendar"
  description="Weekly macroeconomic calendar for USD, EUR, GBP, DXY and Gold with Iran Jalali dates, Tehran and New York release times, and a pre-release USD/DXY fundamental prediction engine."
>
  <main class="shell nw-page" id="newsPage">
    <!-- ================= LOGO LOCKUP + HERO ================= -->
    <section class="hero" style="padding-bottom:6px" aria-labelledby="newsHeroTitle">
      <svg class="nw-logo" viewBox="0 0 720 190" role="img" aria-label="Vaelor Economic Intelligence" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <radialGradient id="nwIconGlow" cx="30%" cy="14%" r="90%">
            <stop offset="0%" stop-color="#e2456c" stop-opacity="0.5"/>
            <stop offset="38%" stop-color="#3a0d17" stop-opacity="0.35"/>
            <stop offset="100%" stop-color="#000000" stop-opacity="0"/>
          </radialGradient>
          <radialGradient id="nwIconCore" cx="50%" cy="35%" r="75%">
            <stop offset="0%" stop-color="#171a20"/>
            <stop offset="100%" stop-color="#050608"/>
          </radialGradient>
          <linearGradient id="nwBorder" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#f2f4f8" stop-opacity="0.95"/>
            <stop offset="0.28" stop-color="#8d97a5" stop-opacity="0.6"/>
            <stop offset="0.5" stop-color="#39414c"/>
            <stop offset="0.72" stop-color="#12151a"/>
            <stop offset="1" stop-color="#07080a"/>
          </linearGradient>
          <linearGradient id="nwChromeLeft" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#f4f6fa"/>
            <stop offset="0.38" stop-color="#b9c2ce"/>
            <stop offset="0.55" stop-color="#5f6a77"/>
            <stop offset="0.72" stop-color="#dfe4ec"/>
            <stop offset="1" stop-color="#59636f"/>
          </linearGradient>
          <linearGradient id="nwRedRight" x1="0" y1="1" x2="0.75" y2="0">
            <stop offset="0" stop-color="#5c1220"/>
            <stop offset="0.35" stop-color="#e2456c"/>
            <stop offset="0.62" stop-color="#ff7288"/>
            <stop offset="0.85" stop-color="#8d1b31"/>
            <stop offset="1" stop-color="#380a13"/>
          </linearGradient>
          <radialGradient id="nwFlare" cx="68%" cy="50%" r="50%">
            <stop offset="0" stop-color="#ff8fa0" stop-opacity="0.95"/>
            <stop offset="0.18" stop-color="#e2456c" stop-opacity="0.85"/>
            <stop offset="0.45" stop-color="#8d1b31" stop-opacity="0.35"/>
            <stop offset="1" stop-color="#000000" stop-opacity="0"/>
          </radialGradient>
          <linearGradient id="nwFlareLine" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#ffffff" stop-opacity="0"/>
            <stop offset="0.3" stop-color="#ffffff" stop-opacity="0.25"/>
            <stop offset="0.68" stop-color="#ff96a6"/>
            <stop offset="0.72" stop-color="#ffffff"/>
            <stop offset="0.76" stop-color="#ff96a6"/>
            <stop offset="1" stop-color="#ffffff" stop-opacity="0"/>
          </linearGradient>
          <linearGradient id="nwWordChrome" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#f7f9fd"/>
            <stop offset="0.34" stop-color="#cfd6df"/>
            <stop offset="0.52" stop-color="#737f8d"/>
            <stop offset="0.62" stop-color="#2f3640"/>
            <stop offset="0.78" stop-color="#c7ced8"/>
            <stop offset="1" stop-color="#5a6572"/>
          </linearGradient>
          <filter id="nwSoft" x="-40%" y="-40%" width="180%" height="180%">
            <feGaussianBlur stdDeviation="9"/>
          </filter>
        </defs>

        <!-- icon -->
        <g>
          <rect x="14" y="10" width="168" height="168" rx="38" fill="url(#nwIconCore)" stroke="url(#nwBorder)" stroke-width="2.5"/>
          <rect x="14" y="10" width="168" height="168" rx="38" fill="url(#nwIconGlow)"/>
          <!-- chrome left arm of the V -->
          <polygon points="42,52 82,142 108,142 68,52" fill="url(#nwChromeLeft)"/>
          <polygon points="48,56 54,64 88,138 82,138" fill="#ffffff" opacity="0.35"/>
          <!-- red right arm of the V -->
          <polygon points="118,142 158,52 132,52 108,142" fill="url(#nwRedRight)"/>
          <polygon points="126,142 152,56 145,56 115,142" fill="#ffd6dc" opacity="0.4"/>
          <!-- silver dot -->
          <circle cx="150" cy="128" r="9.5" fill="url(#nwChromeLeft)" stroke="#05070a" stroke-width="1.5"/>
        </g>

        <!-- wordmark -->
        <text x="212" y="102" font-family="Inter, 'Arial Black', Arial, sans-serif" font-size="86" font-weight="800" letter-spacing="2" fill="url(#nwWordChrome)">VAELOR</text>

        <!-- red flare line -->
        <line x1="214" y1="124" x2="712" y2="124" stroke="url(#nwFlareLine)" stroke-width="1.6"/>
        <ellipse cx="556" cy="124" rx="150" ry="7" fill="url(#nwFlare)" filter="url(#nwSoft)" opacity="0.85"/>
        <circle cx="556" cy="124" r="2" fill="#ffffff"/>

        <!-- caption -->
        <text x="214" y="158" font-family="Inter, Arial, sans-serif" font-size="15.5" font-weight="500" letter-spacing="12.5" fill="#98a4b3">ECONOMIC INTELLIGENCE</text>
      </svg>

      <div class="kicker" style="margin-top:2px">Macro event monitor · weekly outlook</div>
      <h1 id="newsHeroTitle">News that moves markets.</h1>
      <p class="lede">
        High-impact and medium-impact economic releases for <b>USD</b>, <b>EUR</b>, <b>GBP</b>,
        <b>DXY</b> and <b>Gold</b> — every event in <b>Tehran (IRST)</b> or <b>New York (EST/EDT)</b> time,
        on the <b>Gregorian</b> or <b>Solar Hijri</b> calendar, plus a rule-based pre-release
        engine that calls the USD direction before the number drops.
      </p>
      <div class="nw-clockbox">
        <div class="nw-clock"><label>TEHRAN · ASIA/TEHRAN</label><strong id="tehranClock">--:--:--</strong></div>
        <div class="nw-clock"><label>NEW YORK · AMERICA/NEW_YORK</label><strong id="nyClock">--:--:--</strong></div>
      </div>

      <!-- global mutually exclusive toggles -->
      <div class="nw-togglebar" role="toolbar" aria-label="Display preferences">
        <div class="nw-toggle-group">
          <span class="nw-toggle-label" id="calendarToggleLabel">Calendar</span>
          <div class="nw-seg" role="radiogroup" aria-labelledby="calendarToggleLabel">
            <button type="button" role="radio" aria-checked="true" data-calendar="gregorian" class="is-active">Gregorian</button>
            <button type="button" role="radio" aria-checked="false" data-calendar="jalali">Solar Hijri · Jalali</button>
          </div>
        </div>
        <div class="nw-toggle-group">
          <span class="nw-toggle-label" id="tzToggleLabel">Timezone</span>
          <div class="nw-seg" role="radiogroup" aria-labelledby="tzToggleLabel">
            <button type="button" role="radio" aria-checked="true" data-tz="Asia/Tehran" class="is-active">Tehran · IRST</button>
            <button type="button" role="radio" aria-checked="false" data-tz="America/New_York">New York · EST/EDT</button>
          </div>
        </div>
        <p class="nw-toggle-note">Both toggles re-render every date, time and day group on this page instantly.</p>
      </div>
    </section>

    <!-- ================= STATS ================= -->
    <section class="nw-stats" aria-label="Week statistics">
      <div class="nw-stat"><span>THIS WEEK · HIGH IMPACT</span><strong id="highCount">—</strong><em>Red-folder events</em></div>
      <div class="nw-stat"><span>THIS WEEK · MEDIUM IMPACT</span><strong id="mediumCount">—</strong><em>Orange-folder events</em></div>
      <div class="nw-stat"><span>WATCHLIST</span><strong>5</strong><em>USD · EUR · GBP · XAU · DXY</em></div>
      <div class="nw-stat"><span>STORED WEEKS</span><strong id="storedWeeks">—</strong><em id="ledgerHint">Rolling weekly ledger · ~3-month retention</em></div>
      <div class="nw-stat"><span>NEXT WATCH EVENT</span><strong id="nextEvent">—</strong><em id="nextEventTime">Waiting for calendar data</em></div>
    </section>

    <!-- ================= QUICK-ACTION TABS ================= -->
    <div class="nw-tabs" role="tablist" aria-label="News sections">
      <button type="button" role="tab" id="nw-tab-calendar" class="nw-tab is-active" aria-selected="true" aria-controls="nw-panel-calendar" data-tab="calendar" tabindex="0">01 · Calendar</button>
      <button type="button" role="tab" id="nw-tab-engine" class="nw-tab" aria-selected="false" aria-controls="nw-panel-engine" data-tab="engine" tabindex="-1">02 · Automated AI Analysis</button>
      <button type="button" role="tab" id="nw-tab-custom" class="nw-tab" aria-selected="false" aria-controls="nw-panel-custom" data-tab="custom" tabindex="-1">03 · Custom AI Analysis</button>
    </div>

    <!-- ================= PANEL 1 · CALENDAR ================= -->
    <section class="nw-panel-section" role="tabpanel" id="nw-panel-calendar" aria-labelledby="nw-tab-calendar">
      <div class="nw-section-head">
        <div>
          <div class="panel-kicker">WEEKLY RELEASE SCHEDULE</div>
          <div class="nw-weeklabel" id="weekLabel">Events are shown in Tehran and New York local time.</div>
        </div>
        <div class="nw-topright">
          <span class="nw-conn"><i class="nw-dot" id="statusDot"></i><span id="connectionStatus">CONNECTING…</span></span>
          <button type="button" class="nw-btn" id="refreshBtn">Refresh data</button>
        </div>
      </div>

      <!-- weekly pagination -->
      <div class="nw-pager" aria-label="Week navigation">
        <button type="button" class="nw-pager-btn" id="prevWeekBtn" aria-label="Previous week">
          <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M10.5 2 5 8l5.5 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="nw-week-meta">
          <span class="nw-week-big" id="weekBig">This Week</span>
          <span class="nw-week-range" id="weekRange">—</span>
        </div>
        <button type="button" class="nw-pager-btn" id="nextWeekBtn" aria-label="Next week">
          <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M5.5 2 11 8l-5.5 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button type="button" class="nw-thisweek" id="thisWeekBtn" hidden>This week</button>
      </div>

      <div class="nw-filters">
        <label>Asset
          <select id="filterCurrency">
            <option value="all">All watched</option>
            <option value="USD">USD</option>
            <option value="DXY">DXY · USD macro</option>
            <option value="EUR">EUR</option>
            <option value="GBP">GBP</option>
            <option value="XAU">XAU relevance</option>
          </select>
        </label>
        <label>Impact
          <select id="filterImpact">
            <option value="all">High + Medium</option>
            <option value="high">High only · Red</option>
            <option value="medium">Medium only · Orange</option>
          </select>
        </label>
        <label>Day of week
          <select id="filterDay">
            <option value="all">All days</option>
          </select>
        </label>
        <span class="nw-count" id="filterCounts"></span>
      </div>

      <div class="nw-table-wrap">
        <table class="nw-table">
          <thead>
            <tr>
              <th>Release time</th>
              <th>Event</th>
              <th>Currency</th>
              <th>Impact</th>
              <th>Previous</th>
              <th>Forecast</th>
              <th>Actual</th>
            </tr>
          </thead>
          <tbody id="newsTableBody">
            <tr><td colspan="7" class="nw-empty">Loading the weekly calendar…</td></tr>
          </tbody>
        </table>
      </div>
      <p class="nw-hint">
        Low-impact noise is excluded by default. <b>XAU driver</b> tags mark USD releases that directly move XAUUSD
        liquidity and volatility (CPI, PPI, NFP, FOMC, retail sales, ISM…). The same complex drives <b>DXY</b> —
        a stronger print out of the engine means a stronger dollar index. Ledger keeps ~3 months and prunes beyond.
      </p>
    </section>

    <!-- ================= PANEL 2 · AUTOMATED AI ================= -->
    <section class="nw-panel-section" role="tabpanel" id="nw-panel-engine" aria-labelledby="nw-tab-engine" hidden>
      <div class="nw-section-head">
        <div>
          <div class="panel-kicker">AUTOMATED HISTORICAL ANALYSIS</div>
          <p class="nw-weeklabel">System AI reads the tracked release ledger (previous prints + revision direction) alongside the consensus forecast.</p>
        </div>
        <label class="nw-daysel">Analyze day
          <select id="daySelect"><option value="">Loading…</option></select>
        </label>
      </div>
      <div class="nw-panel" id="dayAnalysis">
        <p class="nw-loading">Running the fundamental engine…</p>
      </div>
    </section>

    <!-- ================= PANEL 3 · CUSTOM AI ================= -->
    <section class="nw-panel-section" role="tabpanel" id="nw-panel-custom" aria-labelledby="nw-tab-custom" hidden>
      <div class="nw-section-head">
        <div>
          <div class="panel-kicker">CUSTOM USER AI ANALYSIS · BYO-AI</div>
          <p class="nw-weeklabel">Run the day's engine with your own parameters, or take the same workspace into your own AI client over MCP.</p>
        </div>
        <a class="nw-link" href="/ai">MCP endpoint docs →</a>
      </div>
      <div class="nw-custom-grid">
        <div class="nw-form">
          <label>Custom prompt / instructions
            <textarea id="customPrompt" placeholder="e.g. I trade XAUUSD only around CPI prints — focus on the release-window reaction."></textarea>
          </label>
          <div class="nw-form-row">
            <label>Hypothetical event (optional)
              <input id="hypotheticalEvent" type="text" placeholder="e.g. CPI m/m" />
            </label>
            <label>Hypothetical actual (optional)
              <input id="hypotheticalActual" type="text" placeholder="e.g. 0.5%" />
            </label>
          </div>
          <div class="nw-form-row">
            <label>Target asset
              <select id="targetAsset">
                <option value="all">All cross-asset</option>
                <option value="XAUUSD">XAUUSD</option>
                <option value="DXY">DXY</option>
                <option value="EURUSD">EURUSD</option>
                <option value="GBPUSD">GBPUSD</option>
              </select>
            </label>
            <label>Analysis day
              <select id="customDay"><option value="">Loading…</option></select>
            </label>
          </div>
          <label>Trading bias rules (optional)
            <textarea id="biasRules" placeholder="e.g. Never hold through FOMC. Risk 0.5% max. Flat after NFP Friday." style="min-height:64px"></textarea>
          </label>
          <button type="button" class="nw-btn nw-btn-primary" id="runCustomBtn">Run custom analysis</button>
          <p class="nw-note" style="margin:0">
            The same parameters are accepted by the MCP tool
            <code class="inline">custom_ai_news_analysis</code> at
            <code class="inline">{WORKER}/mcp</code> from your own AI client.
          </p>
        </div>
        <div class="nw-panel nw-custom-result" id="customResult">
          <p class="nw-loading">The result renders here after you run the workspace.</p>
        </div>
      </div>
    </section>
  </main>

  <script>
    import { mountNews } from '../scripts/news.ts';
    mountNews();
  </script>

  <style>
    .nw-page { padding-top: 28px; padding-bottom: 64px; }

    /* logo lockup */
    .nw-logo { width: min(560px, 100%); height: auto; display: block; margin: 4px 0 10px; }
    .kicker {
      font-family: var(--mono);
      font-size: 0.62rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--text-faint);
    }

    /* clocks */
    .nw-clockbox { display: flex; gap: 12px; margin-top: 20px; flex-wrap: wrap; }
    .nw-clock {
      background: var(--bg-panel);
      border: 1px solid var(--border-soft);
      border-radius: 12px;
      padding: 12px 16px;
      min-width: 180px;
    }
    .nw-clock label {
      display: block;
      font-family: var(--mono);
      font-size: 0.6rem;
      letter-spacing: 0.14em;
      color: var(--text-faint);
    }
    .nw-clock strong {
      display: block;
      font-family: var(--mono);
      font-size: 1.35rem;
      font-variant-numeric: tabular-nums;
      color: var(--text);
      margin-top: 4px;
    }

    /* global toggles */
    .nw-togglebar {
      display: flex;
      gap: 18px 28px;
      flex-wrap: wrap;
      align-items: flex-end;
      background: var(--bg-panel);
      border: 1px solid var(--border-soft);
      border-radius: 12px;
      padding: 14px 16px;
      margin-top: 22px;
    }
    .nw-toggle-group { display: flex; flex-direction: column; gap: 6px; }
    .nw-toggle-label {
      font-family: var(--mono);
      font-size: 0.6rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--text-faint);
    }
    .nw-toggle-note {
      font-family: var(--mono);
      font-size: 0.62rem;
      color: var(--text-faint);
      margin: 0 0 2px auto;
      max-width: 260px;
      line-height: 1.6;
    }
    .nw-seg {
      display: inline-flex;
      background: var(--bg);
      border: 1px solid var(--border-soft);
      border-radius: 10px;
      padding: 4px;
      gap: 4px;
    }
    .nw-seg button {
      font-family: var(--mono);
      font-size: 0.72rem;
      color: var(--text-dim);
      background: transparent;
      border: 1px solid transparent;
      border-radius: 7px;
      padding: 8px 14px;
      cursor: pointer;
      transition: color 0.15s, background 0.15s, border-color 0.15s;
      white-space: nowrap;
    }
    .nw-seg button:hover { color: var(--text); }
    .nw-seg button.is-active {
      color: var(--accent-warm);
      background: rgba(201, 162, 75, 0.09);
      border-color: rgba(201, 162, 75, 0.45);
    }
    .nw-seg button:focus-visible { outline: 2px solid var(--accent-warm); outline-offset: 1px; }

    /* stats */
    .nw-stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
      gap: 12px;
      margin: 22px 0 6px;
    }
    .nw-stat {
      background: var(--bg-panel);
      border: 1px solid var(--border-soft);
      border-radius: 12px;
      padding: 13px 15px;
    }
    .nw-stat span { font-family: var(--mono); font-size: 0.58rem; letter-spacing: 0.11em; color: var(--text-faint); }
    .nw-stat strong { display: block; font-family: var(--mono); font-size: 1.4rem; color: var(--text); margin-top: 4px; font-variant-numeric: tabular-nums; }
    .nw-stat em { display: block; font-style: normal; font-family: var(--mono); font-size: 0.62rem; color: var(--text-faint); margin-top: 2px; line-height: 1.5; }

    /* tabs */
    .nw-tabs {
      display: flex;
      gap: 8px;
      border-bottom: 1px solid var(--border-soft);
      margin: 22px 0 18px;
      overflow-x: auto;
      scrollbar-width: thin;
    }
    .nw-tab {
      font-family: var(--mono);
      font-size: 0.72rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      white-space: nowrap;
      color: var(--text-faint);
      background: transparent;
      border: none;
      border-bottom: 2px solid transparent;
      padding: 12px 18px;
      cursor: pointer;
      transition: color 0.15s, border-color 0.15s;
    }
    .nw-tab:hover { color: var(--text-dim); }
    .nw-tab.is-active { color: var(--text); border-bottom-color: var(--accent-warm); }
    .nw-tab:focus-visible { outline: 2px solid var(--accent-warm); outline-offset: -2px; border-radius: 6px; }
    .nw-panel-section[hidden] { display: none !important; }

    /* section heads */
    .nw-section-head {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
      margin-bottom: 14px;
    }
    .panel-kicker {
      font-family: var(--mono);
      font-size: 0.6rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--text-faint);
    }
    .nw-weeklabel { font-family: var(--mono); font-size: 0.7rem; color: var(--text-faint); margin: 6px 0 0; }
    .nw-topright { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
    .nw-link { font-family: var(--mono); font-size: 0.78rem; color: var(--accent); }

    /* connection + buttons */
    .nw-conn {
      display: inline-flex; align-items: center; gap: 8px;
      font-family: var(--mono); font-size: 0.64rem; letter-spacing: 0.1em; color: var(--text-faint);
      border: 1px solid var(--border-soft); border-radius: 999px; padding: 6px 12px; background: var(--bg-panel);
    }
    .nw-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--text-faint); }
    .nw-dot.on { background: var(--ok, #43d6a0); box-shadow: 0 0 10px rgba(67, 214, 160, 0.5); }
    .nw-btn {
      font-family: var(--mono); font-size: 0.72rem; color: var(--text-dim);
      background: var(--bg-panel); border: 1px solid var(--border); border-radius: 8px;
      padding: 8px 15px; cursor: pointer; transition: color 0.15s, border-color 0.15s;
    }
    .nw-btn:hover { color: var(--text); border-color: var(--accent); }
    .nw-btn:disabled { opacity: 0.5; cursor: not-allowed; }
    .nw-btn-primary { color: var(--bg); background: var(--accent-warm); border-color: var(--accent-warm); font-weight: 600; }
    .nw-btn-primary:hover { color: var(--bg); filter: brightness(1.1); border-color: var(--accent-warm); }

    /* week pager */
    .nw-pager {
      display: flex;
      align-items: center;
      gap: 14px;
      background: var(--bg-panel);
      border: 1px solid var(--border-soft);
      border-radius: 12px;
      padding: 10px 14px;
      margin-bottom: 12px;
    }
    .nw-pager-btn {
      width: 40px; height: 40px;
      display: grid; place-items: center;
      background: var(--bg); color: var(--text-dim);
      border: 1px solid var(--border-soft); border-radius: 9px; cursor: pointer;
      transition: color 0.15s, border-color 0.15s, transform 0.12s;
    }
    .nw-pager-btn:hover { color: var(--accent-warm); border-color: rgba(201, 162, 75, 0.45); }
    .nw-pager-btn:active { transform: scale(0.94); }
    .nw-pager-btn:focus-visible { outline: 2px solid var(--accent-warm); outline-offset: 1px; }
    .nw-week-meta { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
    .nw-week-big { font-family: var(--mono); font-size: 0.95rem; font-weight: 700; letter-spacing: 0.06em; color: var(--text); }
    .nw-week-range { font-family: var(--mono); font-size: 0.7rem; color: var(--text-faint); font-variant-numeric: tabular-nums; }
    .nw-thisweek {
      margin-left: auto;
      font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.06em;
