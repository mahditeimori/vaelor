---
import BaseLayout from '../layouts/BaseLayout.astro';

const WORKER = 'https://trading-llc-mcp.mahdi-t8256.workers.dev';
---

<BaseLayout
  title="News · Economic Calendar"
  description="Weekly macroeconomic calendar for USD, EUR, GBP, DXY and Gold with Iran Jalali dates, Tehran and New York release times, and a pre-release USD/DXY fundamental prediction engine."
>
  <main class="shell nw-page" id="newsPage">
    <!-- ================= LOGO LOCKUP + HERO ================= -->
    <section class="hero" style="padding-bottom:6px" aria-labelledby="newsHeroTitle">
      <img
        class="nw-logo"
        src="/vaelor-trading-intelligence.png"
        alt="Vaelor Trading Intelligence"
        width="640"
        height="213"
        decoding="async"
      />

      <div class="kicker" style="margin-top:2px">Macro event monitor · weekly outlook</div>
      <h1 id="newsHeroTitle">News that moves markets.</h1>
      <p class="lede">
        High-impact and medium-impact economic releases for <b>USD</b>, <b>EUR</b>, <b>GBP</b>,
        <b>DXY</b> and <b>Gold</b> — every event in <b>Tehran (IRST)</b> or <b>New York (EST/EDT)</b> time,
        on the <b>Gregorian</b> or <b>Solar Hijri</b> calendar, plus a rule-based pre-release
        engine that calls the USD direction before the number drops.
      </p>
      <div class="nw-clockbox">
        <div class="nw-clock"><label>TEHRAN · ASIA/TEHRAN</label><strong id="tehranClock">--:--:--</strong></div>
        <div class="nw-clock"><label>NEW YORK · AMERICA/NEW_YORK</label><strong id="nyClock">--:--:--</strong></div>
      </div>

      <!-- global mutually exclusive toggles -->
      <div class="nw-togglebar" role="toolbar" aria-label="Display preferences">
        <div class="nw-toggle-group">
          <span class="nw-toggle-label" id="calendarToggleLabel">Calendar</span>
          <div class="nw-seg" role="radiogroup" aria-labelledby="calendarToggleLabel">
            <button type="button" role="radio" aria-checked="true" data-calendar="gregorian" class="is-active">Gregorian</button>
            <button type="button" role="radio" aria-checked="false" data-calendar="jalali">Solar Hijri · Jalali</button>
          </div>
        </div>
        <div class="nw-toggle-group">
          <span class="nw-toggle-label" id="tzToggleLabel">Timezone</span>
          <div class="nw-seg" role="radiogroup" aria-labelledby="tzToggleLabel">
            <button type="button" role="radio" aria-checked="true" data-tz="Asia/Tehran" class="is-active">Tehran · IRST</button>
            <button type="button" role="radio" aria-checked="false" data-tz="America/New_York">New York · EST/EDT</button>
          </div>
        </div>
        <p class="nw-toggle-note">Both toggles re-render every date, time and day group on this page instantly.</p>
      </div>
    </section>

    <!-- ================= STATS ================= -->
    <section class="nw-stats" aria-label="Week statistics">
      <div class="nw-stat"><span>THIS WEEK · HIGH IMPACT</span><strong id="highCount">—</strong><em>Red-folder events</em></div>
      <div class="nw-stat"><span>THIS WEEK · MEDIUM IMPACT</span><strong id="mediumCount">—</strong><em>Orange-folder events</em></div>
      <div class="nw-stat"><span>WATCHLIST</span><strong>5</strong><em>USD · EUR · GBP · XAU · DXY</em></div>
      <div class="nw-stat"><span>STORED WEEKS</span><strong id="storedWeeks">—</strong><em id="ledgerHint">Rolling weekly ledger · ~3-month retention</em></div>
      <div class="nw-stat"><span>NEXT WATCH EVENT</span><strong id="nextEvent">—</strong><em id="nextEventTime">Waiting for calendar data</em></div>
    </section>

    <!-- ================= QUICK-ACTION TABS ================= -->
    <div class="nw-tabs" role="tablist" aria-label="News sections">
      <button type="button" role="tab" id="nw-tab-calendar" class="nw-tab is-active" aria-selected="true" aria-controls="nw-panel-calendar" data-tab="calendar" tabindex="0">
        <span class="nw-tab-num">01</span>
        <span>Calendar</span>
      </button>
      <button type="button" role="tab" id="nw-tab-engine" class="nw-tab" aria-selected="false" aria-controls="nw-panel-engine" data-tab="engine" tabindex="-1">
        <span class="nw-tab-num">02</span>
        <span>Automated AI Analysis</span>
      </button>
      <button type="button" role="tab" id="nw-tab-custom" class="nw-tab" aria-selected="false" aria-controls="nw-panel-custom" data-tab="custom" tabindex="-1">
        <span class="nw-tab-num">03</span>
        <span>Custom AI Analysis</span>
      </button>
    </div>

    <!-- ================= PANEL 1 · CALENDAR ================= -->
    <section class="nw-panel-section" role="tabpanel" id="nw-panel-calendar" aria-labelledby="nw-tab-calendar">
      <div class="nw-section-head">
        <div>
          <div class="panel-kicker">WEEKLY RELEASE SCHEDULE</div>
          <div class="nw-weeklabel" id="weekLabel">Events are shown in Tehran and New York local time.</div>
        </div>
        <div class="nw-topright">
          <span class="nw-conn"><i class="nw-dot" id="statusDot"></i><span id="connectionStatus">CONNECTING…</span></span>
          <button type="button" class="nw-btn" id="refreshBtn">Refresh data</button>
        </div>
      </div>

      <!-- weekly pagination -->
      <div class="nw-pager" aria-label="Week navigation">
        <button type="button" class="nw-pager-btn" id="prevWeekBtn" aria-label="Previous week">
          <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M10.5 2 5 8l5.5 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="nw-week-meta">
          <span class="nw-week-big" id="weekBig">This Week</span>
          <span class="nw-week-range" id="weekRange">—</span>
        </div>
        <button type="button" class="nw-pager-btn" id="nextWeekBtn" aria-label="Next week">
          <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M5.5 2 11 8l-5.5 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button type="button" class="nw-thisweek" id="thisWeekBtn" hidden>This week</button>
      </div>

      <div class="nw-filters">
        <label>Asset
          <select id="filterCurrency">
            <option value="all">All watched</option>
            <option value="USD">USD</option>
            <option value="DXY">DXY · USD macro</option>
            <option value="EUR">EUR</option>
            <option value="GBP">GBP</option>
            <option value="XAU">XAU relevance</option>
          </select>
        </label>
        <label>Impact
          <select id="filterImpact">
            <option value="all">High + Medium</option>
            <option value="high">High only · Red</option>
            <option value="medium">Medium only · Orange</option>
          </select>
        </label>
        <label>Day of week
          <select id="filterDay">
            <option value="all">All days</option>
          </select>
        </label>
        <span class="nw-count" id="filterCounts"></span>
      </div>

      <div class="nw-table-wrap">
        <table class="nw-table">
          <thead>
            <tr>
              <th>Release time</th>
              <th>Event</th>
              <th>Currency</th>
              <th>Impact</th>
              <th>Previous</th>
              <th>Forecast</th>
              <th>Actual</th>
            </tr>
          </thead>
          <tbody id="newsTableBody">
            <tr><td colspan="7" class="nw-empty">Loading the weekly calendar…</td></tr>
          </tbody>
        </table>
      </div>
      <p class="nw-hint">
        Low-impact noise is excluded by default. <b>XAU driver</b> tags mark USD releases that directly move XAUUSD
        liquidity and volatility (CPI, PPI, NFP, FOMC, retail sales, ISM…). The same complex drives <b>DXY</b> —
        a stronger print out of the engine means a stronger dollar index. Ledger keeps ~3 months and prunes beyond.
      </p>
    </section>

    <!-- ================= PANEL 2 · AUTOMATED AI ================= -->
    <section class="nw-panel-section" role="tabpanel" id="nw-panel-engine" aria-labelledby="nw-tab-engine" hidden>
      <div class="nw-section-head">
        <div>
          <div class="panel-kicker">AUTOMATED HISTORICAL ANALYSIS</div>
          <p class="nw-weeklabel">System AI reads the tracked release ledger (previous prints + revision direction) alongside the consensus forecast.</p>
        </div>
        <label class="nw-daysel">Analyze day
          <select id="daySelect"><option value="">Loading…</option></select>
        </label>
      </div>
      <div class="nw-panel" id="dayAnalysis">
        <p class="nw-loading">Running the fundamental engine…</p>
      </div>
    </section>

    <!-- ================= PANEL 3 · CUSTOM AI ================= -->
    <section class="nw-panel-section" role="tabpanel" id="nw-panel-custom" aria-labelledby="nw-tab-custom" hidden>
      <div class="nw-section-head">
        <div>
          <div class="panel-kicker">CUSTOM USER AI ANALYSIS · BYO-AI</div>
          <p class="nw-weeklabel">Run the day's engine with your own parameters, or take the same workspace into your own AI client over MCP.</p>
        </div>
        <a class="nw-link" href="/ai">MCP endpoint docs →</a>
      </div>
      <div class="nw-custom-grid">
        <div class="nw-form">
          <label>Custom prompt / instructions
            <textarea id="customPrompt" placeholder="e.g. I trade XAUUSD only around CPI prints — focus on the release-window reaction."></textarea>
          </label>
          <div class="nw-form-row">
            <label>Hypothetical event (optional)
              <input id="hypotheticalEvent" type="text" placeholder="e.g. CPI m/m" />
            </label>
            <label>Hypothetical actual (optional)
              <input id="hypotheticalActual" type="text" placeholder="e.g. 0.5%" />
            </label>
          </div>
          <div class="nw-form-row">
            <label>Target asset
              <select id="targetAsset">
                <option value="all">All cross-asset</option>
                <option value="XAUUSD">XAUUSD</option>
                <option value="DXY">DXY</option>
                <option value="EURUSD">EURUSD</option>
                <option value="GBPUSD">GBPUSD</option>
              </select>
            </label>
            <label>Analysis day
              <select id="customDay"><option value="">Loading…</option></select>
            </label>
          </div>
          <label>Trading bias rules (optional)
            <textarea id="biasRules" placeholder="e.g. Never hold through FOMC. Risk 0.5% max. Flat after NFP Friday." style="min-height:64px"></textarea>
          </label>
          <button type="button" class="nw-btn nw-btn-primary" id="runCustomBtn">Run custom analysis</button>
          <p class="nw-note" style="margin:0">
            The same parameters are accepted by the MCP tool
            <code class="inline">custom_ai_news_analysis</code> at
            <code class="inline">{WORKER}/mcp</code> from your own AI client.
          </p>
        </div>
        <div class="nw-panel nw-custom-result" id="customResult">
          <p class="nw-loading">The result renders here after you run the workspace.</p>
        </div>
      </div>
    </section>
  </main>

  <script>
    import { mountNews } from '../scripts/news.ts';
    mountNews();
  </script>

  <style is:global>
#newsPage .nw-page {  padding-top: 28px; padding-bottom: 64px;  }#newsPage /* logo lockup */
    .nw-logo { 
      width: min(520px, 100%);
      height: auto;
      display: block;
      margin: 4px 0 10px;
      border-radius: 6px;
     }#newsPage .kicker { 
      font-family: var(--mono);
      font-size: 0.62rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--text-faint);
     }#newsPage /* clocks */
    .nw-clockbox {  display: flex; gap: 12px; margin-top: 20px; flex-wrap: wrap;  }#newsPage .nw-clock { 
      background: var(--bg-panel);
      border: 1px solid var(--border-soft);
      border-radius: 12px;
      padding: 12px 16px;
      min-width: 180px;
     }#newsPage .nw-clock label { 
      display: block;
      font-family: var(--mono);
      font-size: 0.6rem;
      letter-spacing: 0.14em;
      color: var(--text-faint);
     }#newsPage .nw-clock strong { 
      display: block;
      font-family: var(--mono);
      font-size: 1.35rem;
      font-variant-numeric: tabular-nums;
      color: var(--text);
      margin-top: 4px;
     }#newsPage /* global toggles */
    .nw-togglebar { 
      display: flex;
      gap: 18px 28px;
      flex-wrap: wrap;
      align-items: flex-end;
      background: var(--bg-panel);
      border: 1px solid var(--border-soft);
      border-radius: 12px;
      padding: 14px 16px;
      margin-top: 22px;
     }#newsPage .nw-toggle-group {  display: flex; flex-direction: column; gap: 6px;  }#newsPage .nw-toggle-label { 
      font-family: var(--mono);
      font-size: 0.6rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--text-faint);
     }#newsPage .nw-toggle-note { 
      font-family: var(--mono);
      font-size: 0.62rem;
      color: var(--text-faint);
      margin: 0 0 2px auto;
      max-width: 260px;
      line-height: 1.6;
     }#newsPage .nw-seg { 
      display: inline-flex;
      background: var(--bg);
      border: 1px solid var(--border-soft);
      border-radius: 10px;
      padding: 4px;
      gap: 4px;
     }#newsPage .nw-seg button { 
      font-family: var(--mono);
      font-size: 0.72rem;
      color: var(--text-dim);
      background: transparent;
      border: 1px solid transparent;
      border-radius: 7px;
      padding: 8px 14px;
      cursor: pointer;
      transition: color 0.15s, background 0.15s, border-color 0.15s;
      white-space: nowrap;
     }#newsPage .nw-seg button:hover {  color: var(--text);  }#newsPage .nw-seg button.is-active { 
      color: var(--accent-warm);
      background: rgba(201, 162, 75, 0.09);
      border-color: rgba(201, 162, 75, 0.45);
     }#newsPage .nw-seg button:focus-visible {  outline: 2px solid var(--accent-warm); outline-offset: 1px;  }#newsPage /* stats */
    .nw-stats { 
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
      gap: 12px;
      margin: 22px 0 6px;
     }#newsPage .nw-stat { 
      background: var(--bg-panel);
      border: 1px solid var(--border-soft);
      border-radius: 12px;
      padding: 13px 15px;
     }#newsPage .nw-stat span {  font-family: var(--mono); font-size: 0.58rem; letter-spacing: 0.11em; color: var(--text-faint);  }#newsPage .nw-stat strong {  display: block; font-family: var(--mono); font-size: 1.4rem; color: var(--text); margin-top: 4px; font-variant-numeric: tabular-nums;  }#newsPage .nw-stat em {  display: block; font-style: normal; font-family: var(--mono); font-size: 0.62rem; color: var(--text-faint); margin-top: 2px; line-height: 1.5;  }#newsPage /* tabs — separated quick-action buttons */
    .nw-tabs { 
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
      margin: 24px 0 20px;
     }#newsPage .nw-tab { 
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
      text-align: left;
      font-family: var(--mono);
      font-size: 0.74rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      white-space: nowrap;
      color: var(--text-faint);
      background: linear-gradient(180deg, rgba(16, 25, 37, 0.9), rgba(10, 13, 19, 0.9));
      border: 1px solid rgba(255, 255, 255, 0.07);
      border-radius: 12px;
      padding: 14px 18px;
      cursor: pointer;
      transition: color 0.15s, border-color 0.15s, background 0.15s, transform 0.12s;
      position: relative;
      overflow: hidden;
     }#newsPage .nw-tab::before { 
      content: '';
      position: absolute;
      left: 0; top: 0; bottom: 0;
      width: 3px;
      background: transparent;
      transition: background 0.15s;
     }#newsPage .nw-tab:hover {  color: var(--text-dim); border-color: rgba(255, 255, 255, 0.14); transform: translateY(-1px);  }#newsPage .nw-tab.is-active { 
      color: var(--text);
      border-color: rgba(201, 162, 75, 0.5);
      background: linear-gradient(180deg, rgba(201, 162, 75, 0.1), rgba(10, 13, 19, 0.92));
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.05);
     }#newsPage .nw-tab.is-active::before {  background: linear-gradient(180deg, var(--accent-warm), rgba(201, 162, 75, 0.3));  }#newsPage .nw-tab .nw-tab-num { 
      font-size: 0.56rem;
      letter-spacing: 0.18em;
      color: var(--text-faint);
     }#newsPage .nw-tab.is-active .nw-tab-num {  color: var(--accent-warm);  }#newsPage .nw-tab:focus-visible {  outline: 2px solid var(--accent-warm); outline-offset: 2px;  }#newsPage .nw-panel-section[hidden] {  display: none !important;  }#newsPage /* section heads */
    .nw-section-head { 
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
      margin-bottom: 14px;
     }#newsPage .panel-kicker { 
      font-family: var(--mono);
      font-size: 0.6rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--text-faint);
     }#newsPage .nw-weeklabel {  font-family: var(--mono); font-size: 0.7rem; color: var(--text-faint); margin: 6px 0 0;  }#newsPage .nw-topright {  display: flex; align-items: center; gap: 12px; flex-wrap: wrap;  }#newsPage .nw-link {  font-family: var(--mono); font-size: 0.78rem; color: var(--accent);  }#newsPage /* connection + buttons */
    .nw-conn { 
      display: inline-flex; align-items: center; gap: 8px;
      font-family: var(--mono); font-size: 0.64rem; letter-spacing: 0.1em; color: var(--text-faint);
      border: 1px solid var(--border-soft); border-radius: 999px; padding: 6px 12px; background: var(--bg-panel);
     }#newsPage .nw-dot {  width: 7px; height: 7px; border-radius: 50%; background: var(--text-faint);  }#newsPage .nw-dot.on {  background: var(--ok, #43d6a0); box-shadow: 0 0 10px rgba(67, 214, 160, 0.5);  }#newsPage .nw-btn { 
      font-family: var(--mono); font-size: 0.72rem; color: var(--text-dim);
      background: var(--bg-panel); border: 1px solid var(--border); border-radius: 8px;
      padding: 8px 15px; cursor: pointer; transition: color 0.15s, border-color 0.15s;
     }#newsPage .nw-btn:hover {  color: var(--text); border-color: var(--accent);  }#newsPage .nw-btn:disabled {  opacity: 0.5; cursor: not-allowed;  }#newsPage .nw-btn-primary {  color: var(--bg); background: var(--accent-warm); border-color: var(--accent-warm); font-weight: 600;  }#newsPage .nw-btn-primary:hover {  color: var(--bg); filter: brightness(1.1); border-color: var(--accent-warm);  }#newsPage /* week pager */
    .nw-pager { 
      display: flex;
      align-items: center;
      gap: 14px;
      background: var(--bg-panel);
      border: 1px solid var(--border-soft);
      border-radius: 12px;
      padding: 10px 14px;
      margin-bottom: 12px;
     }#newsPage .nw-pager-btn { 
      width: 40px; height: 40px;
      display: grid; place-items: center;
      background: var(--bg); color: var(--text-dim);
      border: 1px solid var(--border-soft); border-radius: 9px; cursor: pointer;
      transition: color 0.15s, border-color 0.15s, transform 0.12s;
     }#newsPage .nw-pager-btn:hover {  color: var(--accent-warm); border-color: rgba(201, 162, 75, 0.45);  }#newsPage .nw-pager-btn:active {  transform: scale(0.94);  }#newsPage .nw-pager-btn:focus-visible {  outline: 2px solid var(--accent-warm); outline-offset: 1px;  }#newsPage .nw-week-meta {  display: flex; flex-direction: column; gap: 2px; min-width: 0;  }#newsPage .nw-week-big {  font-family: var(--mono); font-size: 0.95rem; font-weight: 700; letter-spacing: 0.06em; color: var(--text);  }#newsPage .nw-week-range {  font-family: var(--mono); font-size: 0.7rem; color: var(--text-faint); font-variant-numeric: tabular-nums;  }#newsPage .nw-thisweek { 
      margin-left: auto;
      font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.06em;
      color: var(--accent-warm); background: rgba(201, 162, 75, 0.08);
      border: 1px solid rgba(201, 162, 75, 0.4); border-radius: 999px;
      padding: 8px 16px; cursor: pointer; transition: filter 0.15s;
     }#newsPage .nw-thisweek:hover {  filter: brightness(1.2);  }#newsPage .nw-thisweek[hidden] {  display: none !important;  }#newsPage /* filters */
    .nw-filters { 
      display: flex; gap: 12px; flex-wrap: wrap; align-items: center;
      background: var(--bg-panel); border: 1px solid var(--border-soft);
      border-radius: 12px; padding: 12px 14px; margin-bottom: 14px;
     }#newsPage .nw-filters label { 
      display: flex; flex-direction: column; gap: 4px;
      font-family: var(--mono); font-size: 0.6rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-faint);
     }#newsPage .nw-filters select { 
      background: var(--bg); color: var(--text); border: 1px solid var(--border-soft);
      border-radius: 8px; padding: 8px 10px; font-family: var(--mono); font-size: 0.76rem; min-width: 150px;
     }#newsPage .nw-filters select:focus-visible {  outline: 2px solid var(--accent-warm); outline-offset: 1px; border-color: transparent;  }#newsPage .nw-count {  font-family: var(--mono); font-size: 0.68rem; color: var(--text-faint); margin-left: auto;  }#newsPage /* table — thin rules, #newsPage ledger feel */
    .nw-table-wrap { 
      overflow-x: auto;
      border: 1px solid rgba(255, 255, 255, 0.07);
      border-radius: 14px;
      background: linear-gradient(180deg, rgba(16, 25, 37, 0.92), rgba(10, 13, 19, 0.92));
      box-shadow: 0 18px 44px rgba(0, 0, 0, 0.35);
     }#newsPage .nw-table {  width: 100%; border-collapse: collapse; min-width: 720px;  }#newsPage .nw-table thead th { 
      text-align: left;
      font-family: var(--mono);
      font-size: 0.58rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--text-faint);
      padding: 14px 16px 12px;
      background: rgba(255, 255, 255, 0.02);
      border-bottom: 1px solid rgba(255, 255, 255, 0.09);
      font-weight: 600;
      white-space: nowrap;
     }#newsPage .nw-table thead th:nth-child(n + 5) {  text-align: right;  }#newsPage .nw-table tbody tr.nw-row td { 
      padding: 13px 16px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.045);
      color: var(--text-dim);
      font-size: 0.82rem;
      vertical-align: middle;
     }#newsPage .nw-table tbody tr.nw-row:last-child td {  border-bottom: none;  }#newsPage .nw-table tbody tr.nw-row:hover td {  background: rgba(214, 178, 94, 0.045);  }#newsPage .nw-table tbody tr.nw-row:hover .nw-event-text strong {  color: var(--text);  }#newsPage .nw-table td:nth-child(5), #newsPage .nw-table td:nth-child(6), #newsPage .nw-table td:nth-child(7) { 
