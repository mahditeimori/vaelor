---
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="dark" />
    <title>Owner console — Vaelor Trading LLC</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Playfair+Display:ital,wght@0,600;0,700;1,400&display=swap" rel="stylesheet" />
  </head>
  <body class="owner-body">
    <main id="ownerPage" class="o-shell">
      <!-- Access gate -->
      <section class="o-gate" id="ownerGate">
        <div class="o-gate-card">
          <div class="o-brand-row">
            <img src="/vaelor-trading-intelligence.png" alt="Vaelor Trading Intelligence" width="760" height="253" />
          </div>
          <div class="o-kicker">OWNER CONSOLE · RESTRICTED</div>
          <h1>Desk oversight</h1>
          <p class="o-lede">
            Members, plans, activity and the paired MT5 desk. This route is not linked anywhere on the
            public site.
          </p>
          <form id="ownerGateForm" class="o-gate-form">
            <label for="ownerKey">Access key</label>
            <input id="ownerKey" type="password" autocomplete="off" spellcheck="false" placeholder="Owner access key" />
            <button type="submit">Unlock console</button>
            <p class="o-gate-error" id="ownerGateError"></p>
          </form>
        </div>
      </section>

      <!-- Console -->
      <section id="ownerApp" hidden>
        <header class="o-top">
          <div>
            <div class="o-kicker">OWNER CONSOLE · PRIVATE</div>
            <h1>Desk oversight</h1>
            <p class="o-sub" id="oSub">Members, subscriptions, activity and the MT5 bridge.</p>
          </div>
          <div class="o-top-actions">
            <button type="button" class="o-btn ghost" id="ownerRefresh">Refresh</button>
            <button type="button" class="o-btn ghost" id="ownerLock">Lock</button>
          </div>
        </header>

        <div class="o-stats">
          <div class="o-stat"><span>Members</span><b id="oMembersTotal">0</b></div>
          <div class="o-stat"><span>Subscribed</span><b id="oMembersPaid">0</b></div>
          <div class="o-stat"><span>Free tier</span><b id="oMembersFree">0</b></div>
          <div class="o-stat"><span>Est. MRR</span><b id="oMembersMrr">$0</b></div>
        </div>

        <div class="o-grid">
          <section class="o-panel">
            <div class="o-panel-head">
              <h2>Members</h2>
              <span class="o-mono">LOCAL REGISTRY</span>
            </div>
            <div class="o-table-wrap">
              <table class="o-table">
                <thead>
                  <tr>
                    <th>Member</th>
                    <th>Plan</th>
                    <th>Remaining</th>
                    <th>Unread</th>
                    <th>Last activity</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody id="ownerMembers"></tbody>
              </table>
            </div>
          </section>

          <section id="ownerUserDetail" class="o-panel hidden">
            <h2 class="o-title">User Details <span id="userDetailClose">✕</span></h2>
            <div id="ownerUserDetailBody"></div>
          </section>

          <section class="o-panel">
            <div class="o-panel-head">
              <h2>Upgrade requests <span class="o-req-count" id="oReqCount">0</span></h2>
              <span class="o-mono">PENDING</span>
            </div>
            <div id="ownerRequests"></div>
          </section>

          <section class="o-panel">
            <div class="o-panel-head">
              <h2>MT5 desk snapshot</h2>
              <span class="o-mono">BRIDGE /API/STATUS</span>
            </div>
            <div id="ownerBridge"></div>
          </section>

          <section class="o-panel">
            <div class="o-panel-head">
              <h2>Recent member activity</h2>
              <span class="o-mono">NOTIFICATION FEED</span>
            </div>
            <div id="ownerActivity"></div>
          </section>

          <section id="ownerFeatures" class="o-panel">
            <div class="o-panel-head">
              <h2>Capability catalog — Feature Manager</h2>
              <span class="o-mono">OWNER · /api/owner/features</span>
            </div>
            <div id="ownerFeaturesList"></div>
            <form id="addCapabilityForm" class="o-form">
              <div class="o-form-row">
                <label for="capName">Name</label>
                <input id="capName" type="text" placeholder="e.g. Cross-Session Hedging" required />
              </div>
              <div class="o-form-row">
                <label for="capDesc">Description</label>
                <textarea id="capDesc" placeholder="What the capability does…" rows="2"></textarea>
              </div>
              <div class="o-form-grid">
                <div class="o-form-row full">
                  <label for="capSection">Section</label>
                  <select id="capSection">
                    <option value="Terminal">Terminal</option>
                    <option value="Execution">Execution</option>
                    <option value="Playbook">Playbook</option>
                    <option value="Other" selected>Other</option>
                  </select>
                </div>
                <div class="o-form-row">
                  <label for="capTier">Tier (Observer/Operator/Desk)</label>
                  <select id="capTier">
                    <option value="free">Observer</option>
                    <option value="operator" selected>Operator</option>
                    <option value="desk">Desk</option>
                  </select>
                </div>
                <div class="o-form-row">
                  <label for="capPrice">Price per month (USD)</label>
                  <input id="capPrice" type="number" min="0" step="0.01" value="0" />
                </div>
              </div>
              <button type="submit" class="o-btn">Add capability</button>
            </form>
          </section>

          <section id="ownerStrategies" class="o-panel">
            <div class="o-panel-head">
              <h2>Strategies — Strategy Manager</h2>
              <span class="o-mono">OWNER · /api/owner/strategies</span>
            </div>
            <div id="ownerStrategiesList"></div>
            <form id="addStrategyForm" class="o-form">
              <div class="o-form-row">
                <label for="stratTitle">Title</label>
                <input id="stratTitle" type="text" placeholder="e.g. VWAP Baseline" required />
              </div>
              <div class="o-form-row">
                <label for="stratDesc">Description</label>
                <textarea id="stratDesc" placeholder="How the owner uses it…" rows="2"></textarea>
              </div>
              <div class="o-form-row">
                <label for="stratId">StrategyId (optional, e.g. VWAP-v3)</label>
                <input id="stratId" type="text" placeholder="VWAP-v3" />
              </div>
              <div class="o-form-row">
                <label>Visible tiers</label>
                <div class="o-tier-checks">
                  <label class="o-tier-check"><input type="checkbox" value="free" /> Observer</label>
                  <label class="o-tier-check"><input type="checkbox" value="operator" /> Operator</label>
                  <label class="o-tier-check"><input type="checkbox" value="desk" /> Desk</label>
                </div>
              </div>
              <button type="submit" class="o-btn">Add strategy</button>
            </form>
          </section>
        </div>

        <p class="o-fine">
          Plan changes take effect on the member's next page load in this browser. Bridge figures are
          read from the paired bridge and are never synthesised.
        </p>
      </section>
    </main>

    <script>
      import { mountOwner } from '../scripts/owner.ts';
      mountOwner();
    </script>

    <style>
      .owner-body {
        margin: 0;
        min-height: 100vh;
        background:
          radial-gradient(900px 500px at 85% -10%, rgba(225, 29, 72, 0.14), transparent 60%),
          #060305;
        color: #f5f0f2;
        font-family: Inter, system-ui, sans-serif;
      }
      .o-shell { max-width: 1180px; margin: 0 auto; padding: 40px 22px 70px; }
      .o-gate { min-height: 80vh; display: grid; place-items: center; }
      .o-gate-card {
        width: min(460px, 100%);
        padding: 30px;
        border-radius: 18px;
        border: 1px solid rgba(225, 29, 72, 0.28);
        background: rgba(16, 9, 12, 0.92);
        box-shadow: 0 40px 90px -30px rgba(0, 0, 0, 0.85);
      }
      .o-brand-row img { width: 180px; height: auto; }
      .o-kicker {
        font-family: 'JetBrains Mono', monospace;
        font-size: 9.5px;
        letter-spacing: 0.24em;
        color: #e11d48;
        margin-top: 18px;
      }
      .o-gate-card h1 { font-family: 'Playfair Display', serif; font-size: 30px; margin: 10px 0 8px; }
      .o-lede { font-size: 12.5px; line-height: 1.7; color: #a5979d; margin: 0 0 20px; }
      .o-gate-form { display: flex; flex-direction: column; gap: 8px; }
      .o-gate-form label {
        font-family: 'JetBrains Mono', monospace;
        font-size: 9.5px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: #8d7f85;
      }
      .o-gate-form input {
        padding: 12px;
        border-radius: 11px;
        border: 1px solid rgba(255, 255, 255, 0.14);
        background: rgba(0, 0, 0, 0.4);
        color: #fff;
        font: inherit;
        font-size: 13px;
        outline: none;
      }
      .o-gate-form input:focus { border-color: rgba(225, 29, 72, 0.55); }
      .o-gate-form button {
        padding: 12px;
        border-radius: 11px;
        border: none;
        background: linear-gradient(135deg, #e11d48, #be185d);
        color: #fff;
        font: inherit;
        font-size: 12.5px;
        font-weight: 600;
        cursor: pointer;
      }
      .o-gate-error { min-height: 16px; margin: 4px 0 0; color: #fb7185; font-size: 11px; }

      .o-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; margin-bottom: 22px; }
      .o-top h1 { font-family: 'Playfair Display', serif; font-size: clamp(28px, 4vw, 38px); margin: 8px 0 4px; }
      .o-sub { margin: 0; color: #a5979d; font-size: 13px; }
      .o-top-actions { display: flex; gap: 8px; }
      .o-btn { padding: 9px 14px; border-radius: 10px; border: 1px solid rgba(255, 255, 255, 0.14); background: rgba(255, 255, 255, 0.04); color: #e9e0e4; font: inherit; font-size: 12px; cursor: pointer; }
      .o-btn:hover { border-color: rgba(225, 29, 72, 0.5); color: #fff; }

      .o-stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; margin-bottom: 16px; }
      .o-stat { padding: 15px; border-radius: 14px; border: 1px solid rgba(255, 255, 255, 0.08); background: rgba(255, 255, 255, 0.03); }
      .o-stat span { display: block; font-family: 'JetBrains Mono', monospace; font-size: 9px; letter-spacing: 0.16em; text-transform: uppercase; color: #8d7f85; margin-bottom: 7px; }
      .o-stat b { font-family: 'Playfair Display', serif; font-size: 22px; }

      .o-grid { display: grid; grid-template-columns: 1fr; gap: 14px; }
      .o-panel { border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 16px; background: rgba(14, 8, 11, 0.75); padding: 18px; }
      .o-panel-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; gap: 10px; }
      .o-panel-head h2 { font-family: 'Playfair Display', serif; font-size: 18px; margin: 0; }
      .o-mono { font-family: 'JetBrains Mono', monospace; font-size: 9px; letter-spacing: 0.14em; color: #8d7f85; }
      .o-req-count { display: inline-grid; place-items: center; min-width: 20px; height: 20px; padding: 0 6px; border-radius: 999px; background: #e11d48; font-family: 'JetBrains Mono', monospace; font-size: 10px; vertical-align: middle; }

      .o-table-wrap { overflow-x: auto; }
      .o-table { width: 100%; border-collapse: collapse; }
      .o-table th {
        text-align: left;
        font-family: 'JetBrains Mono', monospace;
        font-size: 9px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #8d7f85;
        padding: 8px 10px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      }
      .o-table td { padding: 10px; border-bottom: 1px solid rgba(255, 255, 255, 0.05); font-size: 12px; vertical-align: middle; }
      .o-sub { display: block; font-family: 'JetBrains Mono', monospace; font-size: 9.5px; color: #8d7f85; margin-top: 2px; }
      .o-tag {
        display: inline-block;
        padding: 3px 8px;
        border-radius: 999px;
        border: 1px solid rgba(255, 255, 255, 0.16);
        font-family: 'JetBrains Mono', monospace;
        font-size: 8.5px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #b3a6ac;
      }
      .o-tag.ok { border-color: rgba(52, 211, 153, 0.45); color: #6ee7b7; background: rgba(16, 185, 129, 0.08); }
      .o-actions { display: flex; gap: 6px; flex-wrap: wrap; }
      .o-actions button {
        padding: 6px 9px;
        border-radius: 8px;
        border: 1px solid rgba(255, 255, 255, 0.14);
        background: none;
        color: #d8ccd1;
        font-family: 'JetBrains Mono', monospace;
        font-size: 9.5px;
        cursor: pointer;
      }
      .o-actions button:hover { border-color: rgba(225, 29, 72, 0.5); color: #fff; }
      .o-empty { color: #8d7f85; font-size: 12.5px; margin: 0; }
      .o-ok { color: #6ee7b7 !important; }
      .o-bad { color: #fb7185 !important; }

      #ownerUserDetail h2.o-title {
        font-family: 'Playfair Display', serif;
        font-size: 18px;
        margin: 0 0 10px;
      }
      #userDetailClose {
        float: right;
        font-size: 13px;
        cursor: pointer;
        color: #a5979d;
      }

      .o-req { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 11px; border-radius: 11px; border: 1px solid rgba(255, 255, 255, 0.08); background: rgba(255, 255, 255, 0.02); margin-bottom: 8px; flex-wrap: wrap; }
      .o-req b { font-size: 12.5px; }
      .o-req span { display: block; font-family: 'JetBrains Mono', monospace; font-size: 9.5px; color: #8d7f85; margin-top: 3px; }

      .o-bridge-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 9px; }
      .o-b-card { padding: 11px; border-radius: 10px; border: 1px solid rgba(255, 255, 255, 0.07); background: rgba(255, 255, 255, 0.02); }
      .o-b-card span { display: block; font-family: 'JetBrains Mono', monospace; font-size: 8.5px; letter-spacing: 0.12em; text-transform: uppercase; color: #8d7f85; margin-bottom: 5px; }
      .o-b-card b { font-size: 12.5px; }

      .o-act { display: grid; grid-template-columns: 90px 1fr auto; gap: 10px; align-items: center; padding: 9px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.05); font-size: 12px; }
      .o-act time { font-family: 'JetBrains Mono', monospace; font-size: 9px; color: #75686e; }
      .o-fine { font-size: 10.5px; line-height: 1.7; color: #75686e; margin-top: 16px; }

      .o-user-link {
        padding: 0;
        border: none;
        background: none;
        color: inherit;
        font: inherit;
        text-align: left;
        cursor: pointer;
        border-bottom: 1px dotted rgba(255, 255, 255, 0.35);
      }
      .o-user-link:hover { border-bottom-color: #e11d48; }
      .o-close {
        border: 1px solid rgba(255, 255, 255, 0.14);
        background: rgba(255, 255, 255, 0.04);
        color: #d8ccd1;
        border-radius: 7px;
        padding: 3px 8px;
        font-size: 11px;
        cursor: pointer;
      }
      .o-close:hover { border-color: #e11d48; color: #fff; }
      .o-d-head { font-size: 12.5px; }
      .o-d-head b { font-size: 14px; }
      .o-d-head .o-sub { display: block; margin-top: 2px; }
      .o-d-meta { font-size: 10.5px; color: #a5979d; font-family: 'JetBrains Mono', monospace; margin-top: 5px; word-break: break-all; }
      .o-d-sec { margin-top: 15px; padding-top: 12px; border-top: 1px solid rgba(255, 255, 255, 0.06); }
      .o-d-sec h3 { font-family: 'JetBrains Mono', monospace; font-size: 9px; letter-spacing: 0.16em; text-transform: uppercase; color: #8d7f85; margin: 0 0 9px; }
      .o-d-act { display: grid; grid-template-columns: auto 1fr auto; gap: 10px; align-items: start; font-size: 11.5px; padding: 5px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.05); }
      .o-d-act b { font-size: 12px; }
      .o-d-act time { font-size: 9px; color: #75686e; margin-top: 2px; }
      .o-d-unread { font-size: 10.5px; color: #e9e0e4; margin-bottom: 6px; }
      .o-d-sess { font-size: 11px; color: #a5979d; margin-bottom: 5px; }
      .o-btn.danger { border-color: rgba(251, 113, 133, 0.5); color: #fb7185; }
      .o-btn.danger:hover { border-color: #fb7185; background: rgba(251, 113, 133, 0.12); color: #fff; }

      #ownerToast {
        position: fixed;
        left: 50%;
        bottom: 22px;
        transform: translate(-50%, 14px);
        padding: 11px 16px;
        border-radius: 10px;
        border: 1px solid rgba(225, 29, 72, 0.4);
        background: rgba(20, 11, 15, 0.98);
        color: #f7e9ee;
        font-size: 12.5px;
        opacity: 0;
        pointer-events: none;
        transition: 0.22s;
        z-index: 50;
      }
      #ownerToast.show { opacity: 1; transform: translate(-50%, 0); }

      .o-feature-list { display: flex; flex-direction: column; gap: 9px; margin-bottom: 14px; }
      .o-feature, .o-strategy {
        border: 1px solid rgba(255, 255, 255, 0.07);
        border-radius: 11px;
        padding: 11px;
        background: rgba(255, 255, 255, 0.02);
      }
      .o-feature-head { display: flex; justify-content: space-between; gap: 10px; align-items: center; flex-wrap: wrap; }
      .o-feature-benefits {
        margin: 7px 0 0;
        padding-left: 18px;
        font-size: 11.5px;
        color: #a89aa0;
        line-height: 1.6;
      }
      .o-strategy-meta { display: flex; gap: 10px; flex-wrap: wrap; font-size: 10.5px; color: #6f5f66; }
      .o-form { display: grid; gap: 10px; }
      .o-form-row { display: flex; flex-direction: column; gap: 4px; }
      .o-form-row.full { grid-column: 1 / -1; }
      .o-form-row label {
        font-family: 'JetBrains Mono', monospace;
        font-size: 9px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #8d7f85;
      }
      .o-form input[type="text"],
      .o-form input[type="number"],
      .o-form select,
      .o-form textarea {
        padding: 10px;
        border-radius: 9px;
        border: 1px solid rgba(255, 255, 255, 0.14);
        background: rgba(0, 0, 0, 0.35);
        color: #fff;
        font: inherit;
        font-size: 12.5px;
        outline: none;
      }
      .o-form input:focus, .o-form select:focus, .o-form textarea:focus { border-color: rgba(225, 29, 72, 0.55); }
      .o-form textarea { resize: vertical; min-height: 58px; }
      .o-form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
      .o-form button {
        justify-self: start;
        padding: 9px 15px;
        border-radius: 9px;
        border: none;
        background: linear-gradient(135deg, #e11d48, #be185d);
        color: #fff;
        font: inherit;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
      }
      .o-tier-checks { display: flex; gap: 14px; flex-wrap: wrap; align-items: center; }
      .o-tier-check { display: inline-flex; gap: 6px; align-items: center; font-family: 'JetBrains Mono', monospace; font-size: 9.5px; color: #b3a6ac; }
      .o-tier-check input { accent-color: #e11d48; }

      @media (max-width: 760px) {
        .o-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .o-act { grid-template-columns: 1fr; }
      }
    </style>
  </body>
</html>
