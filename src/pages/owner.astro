---
import '../styles/global.css';
import '../styles/owner-enhanced.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="dark" />
    <title>Owner console — Vaelor Trading LLC</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Playfair+Display:ital,wght@0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="owner-body">
    <main id="ownerPage" class="o-shell">
      <!-- Access gate -->
      <section class="o-gate" id="ownerGate">
        <div class="o-gate-card">
          <div class="o-brand-row">
            <img src="/vaelor-trading-intelligence.png" alt="Vaelor Trading Intelligence" width="760" height="253" />
          </div>
          <div class="o-kicker">OWNER CONSOLE · RESTRICTED</div>
          <h1>Desk supervision</h1>
          <p class="o-lede">
            All users, plans, activity, audit and the paired MT5 desk. This route is not linked anywhere on the
            public site.
          </p>
          <form id="ownerGateForm" class="o-gate-form">
            <label for="ownerKey">Access key</label>
            <input id="ownerKey" type="password" autocomplete="off" spellcheck="false" placeholder="Owner access key" />
            <button type="submit">Unlock console</button>
            <p class="o-gate-error" id="ownerGateError"></p>
          </form>
        </div>
      </section>

      <!-- Console -->
      <section id="ownerApp" hidden>
        <header class="o-header">
          <div class="o-header-main">
            <div class="o-kicker">OWNER CONSOLE · FULL ACCESS</div>
            <h1>Desk supervision</h1>
            <p class="o-sub">All members, subscriptions, activity, audit and MT5 bridge figures.</p>
          </div>
          <div class="o-toolbar">
            <input
              id="oSearch"
              type="search"
              placeholder="Search members, username or email…"
              aria-label="Search members"
              class="o-input"
            />
            <select id="oSort" class="o-select" aria-label="Sort members">
              <option value="newest">Newest first</option>
              <option value="name">Name A–Z</option>
              <option value="paid">Paid first</option>
              <option value="active">Most active</option>
            </select>
            <button type="button" id="oRefresh" class="o-btn ghost" aria-label="Refresh member data">Refresh</button>
            <button type="button" id="oLock" class="o-btn danger" aria-label="Lock owner console">Lock</button>
          </div>
        </header>

        <nav id="oNav" class="o-nav" aria-label="Owner console sections">
          <button type="button" data-nav="overview" class="o-nav-link is-active">Overview</button>
          <button type="button" data-nav="members">Members</button>
          <button type="button" data-nav="requests">Requests</button>
          <button type="button" data-nav="bridge">Bridge</button>
          <button type="button" data-nav="activity">Activity</button>
          <button type="button" data-nav="audit">Audit</button>
          <button type="button" data-nav="features">Features</button>
          <button type="button" data-nav="strategies">Strategies</button>
        </nav>

        <section id="oUserDetail" class="o-panel hidden">
          <div class="o-d-head">
            <div>
              <h2 id="oUserDetailTitle" class="o-panel-title">User details</h2>
              <div id="oUserDetailMeta" class="o-d-meta"></div>
            </div>
            <button type="button" id="oUserDetailClose" class="o-btn ghost">✕</button>
          </div>
          <div id="oUserDetailTabs" class="o-tabs" role="tablist" aria-label="User details tabs"></div>
          <div id="oUserDetailBody" class="o-user-detail-body"></div>
        </section>

        <section id="oStats" class="o-stats">
          <div id="oKpiMembers" class="o-kpi">
            <span>Members</span>
            <b id="oMembersTotal" class="k">0</b>
            <small id="oMembersTotalSub"></small>
          </div>
          <div id="oKpiPaid" class="o-kpi ok">
            <span>Subscribed</span>
            <b id="oMembersPaid" class="k">0</b>
            <small id="oMembersPaidSub"></small>
          </div>
          <div id="oKpiFree" class="o-kpi">
            <span>Free tier</span>
            <b id="oMembersFree" class="k">0</b>
            <small id="oMembersFreeSub"></small>
          </div>
          <div id="oKpiMrr" class="o-kpi warm">
            <span>Estimated MRR</span>
            <b id="oMembersMrr" class="k">$0</b>
            <small id="oMembersMrrSub"></small>
          </div>
          <div id="oKpiSessions" class="o-kpi">
            <span>Live sessions</span>
            <b id="oSessionsTotal" class="k">0</b>
            <small id="oSessionsSub"></small>
          </div>
          <div id="oKpiGrowth" class="o-kpi">
            <span>Paid since first member</span>
            <b id="oMrrRatio" class="k">0%</b>
            <small id="oMrrRatioSub"></small>
          </div>
        </section>

        <section id="oMembers" class="o-panel">
          <h2>Members</h2>
          <div id="oMembersToolbar" class="o-toolbar">
            <div id="oTierTabs" class="o-tier-tabs" role="tablist" aria-label="Filter by tier"></div>
            <div id="oMembersMeta" class="o-mono"></div>
          </div>
          <div class="o-table-wrap">
            <table class="o-table">
              <thead>
                <tr>
                  <th>Member</th>
                  <th>Tier</th>
                  <th>Since</th>
                  <th>Plan MRR</th>
                  <th>Days left</th>
                  <th>Unread</th>
                  <th>Last activity</th>
                  <th class="o-actions-head">Actions</th>
                </tr>
              </thead>
              <tbody id="ownerMembers"></tbody>
            </table>
          </div>
        </section>

        <section id="oMrrChart" class="o-panel">
          <h2>Monthly MRR trend</h2>
          <div id="oMrrChartCanvas" class="o-chart-wrap"></div>
        </section>

        <section id="oRequests" class="o-panel">
          <div class="o-panel-head">
            <h2>Upgrade requests <span class="o-req-count" id="oReqCount">0</span></h2>
            <span class="o-mono">SUBRSCRIPTION REQUESTS</span>
          </div>
          <div id="ownerRequests"></div>
        </section>

        <section id="oBridge" class="o-panel">
          <div class="o-panel-head">
            <h2>MT5 desk snapshot</h2>
            <span class="o-mono">BRIDGE /API/STATUS</span>
          </div>
          <div id="ownerBridge"></div>
        </section>

        <section id="oActivity" class="o-panel">
          <div class="o-panel-head">
            <h2>Recent member activity</h2>
            <span class="o-mono">NOTIFICATION FEED</span>
          </div>
          <div id="ownerActivity"></div>
        </section>

        <section id="oAudit" class="o-panel">
          <div class="o-panel-head">
            <h2>Audit log</h2>
            <span class="o-mono">BRIDGE /API/AUDIT</span>
          </div>
          <div id="ownerAudit"></div>
        </section>

        <section id="oFeatures" class="o-panel">
          <div class="o-panel-head">
            <h2>Capability catalog — Feature Manager</h2>
            <span class="o-mono">OWNER · /api/owner/features</span>
          </div>
          <div class="o-toolbar">
            <input id="oFeatureSearch" type="search" placeholder="Filter capabilities…" aria-label="Filter capabilities" />
          </div>
          <div id="ownerFeaturesList" class="o-feature-grid"></div>
          <form id="addCapabilityForm" class="o-form o-form-grid-owner">
            <div class="o-form-row">
              <label for="capName">Name</label>
              <input id="capName" type="text" placeholder="e.g. Cross-Session Hedging" required />
            </div>
            <div class="o-form-row">
              <label for="capDesc">Description</label>
              <textarea id="capDesc" placeholder="What the capability does…" rows="2"></textarea>
            </div>
            <div class="o-form-grid">
              <div class="o-form-row full">
                <label for="capSection">Section</label>
                <select id="capSection">
                  <option value="Terminal">Terminal</option>
                  <option value="Execution">Execution</option>
                  <option value="Playbook">Playbook</option>
                  <option value="Other" selected>Other</option>
                </select>
              </div>
              <div class="o-form-row">
                <label for="capTier">Tier</label>
                <select id="capTier">
                  <option value="free">Observer</option>
                  <option value="operator" selected>Operator</option>
                  <option value="desk">Desk</option>
                </select>
              </div>
              <div class="o-form-row">
                <label for="capPrice">Price per month (USD)</label>
                <input id="capPrice" type="number" min="0" step="0.01" value="0" />
              </div>
            </div>
            <button type="submit" class="o-btn">Add capability</button>
          </form>
        </section>

        <section id="oStrategies" class="o-panel">
          <div class="o-panel-head">
            <h2>Strategies — Strategy Manager</h2>
            <span class="o-mono">OWNER · /api/owner/strategies</span>
          </div>
          <div class="o-toolbar">
            <input id="oStrategySearch" type="search" placeholder="Filter strategies…" aria-label="Filter strategies" />
          </div>
          <div id="ownerStrategiesList" class="o-strategy-grid"></div>
          <form id="addStrategyForm" class="o-form o-form-grid-owner">
            <div class="o-form-row">
              <label for="stratTitle">Title</label>
              <input id="stratTitle" type="text" placeholder="e.g. VWAP Baseline" required />
            </div>
            <div class="o-form-row">
              <label for="stratDesc">Description</label>
              <textarea id="stratDesc" placeholder="How the owner uses it…" rows="2"></textarea>
            </div>
            <div class="o-form-row">
              <label for="stratId">StrategyId</label>
              <input id="stratId" type="text" placeholder="VWAP-v3" />
            </div>
            <div class="o-form-row">
              <label>Visible tiers</label>
              <div class="o-tier-checks">
                <label class="o-tier-check"><input type="checkbox" value="free" /> Observer</label>
                <label class="o-tier-check"><input type="checkbox" value="operator" /> Operator</label>
                <label class="o-tier-check"><input type="checkbox" value="desk" /> Desk</label>
              </div>
            </div>
            <button type="submit" class="o-btn">Add strategy</button>
          </form>
        </section>

        <p class="o-fine">
          Plan changes take effect on the member's next page load in this browser. Bridge figures are read from the
          paired bridge and are never synthesised.
        </p>
      </section>
    </main>

    <script>
      import { mountOwner } from '../scripts/owner.ts';
      mountOwner();
    </script>
  </body>
</html>
